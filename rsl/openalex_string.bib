@article{tingxi2026code,
  title = {Code Hallucination Detection via Multi-Agent Debate: Mitigating Degeneration-of-Thought through Adversarial Consensus},
  author = {Li TingXi and Qingchun Hu and Han XinTao and Tang YuFei},
  journal = {ACM Turing Celebration Conference - China (ACM TURC)},
  year = {2026},
  pages = {173--174},
  doi = {10.1145/3833142.3833184},
  url = {https://doi.org/10.1145/3833142.3833184},
  publisher = {Association for Computing Machinery},
  keywords = {multi-agent debate, large language models, self-reflection},
  abstract = {Large language models (LLMs) frequently generate plausible yet incorrect code—calling non-existent functions, importing fabricated modules, or containing subtle logic errors. Single-LLM detection degrades on full competition-level programs due to Degeneration-of-Thought (DoT): once a model forms a judgment, it struggles to discover novel thoughts through self-reflection. This paper applies Multi-Agent Debate (MAD) to code hallucination detection. On 1,048 competition-level Python program pairs spanning five types, MAD achieves 81.13% both-correct accuracy, +18.39 pp over an independent baseline. Logic Error detection shows the largest gain at +22.44 pp. Even with weaker agents, the framework approaches the strongest single model with 100% coverage. Judge sensitivity shows debate improves with a weak judge but yields zero gain when judge and debater share the same model. Dynamics reveals 81.8% convergence within 3 rounds, driven by role asymmetry: Negative stable in 86.2%, Affirmative concedes in 71.2%.},
}

@article{padwal2026codegolf,
  title = {CodeGolf Bench: A Multi-Language Benchmark for Evaluating Concise Code Generation Capabilities of Large Language Models},
  author = {Vedant Padwal},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2605.30394},
  url = {https://doi.org/10.48550/arxiv.2605.30394},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {large language models, code generation evaluation, reasoning models, Python, C++, efficiency optimization},
  abstract = {This paper introduces Code Bench, a benchmark capable of evaluating Large Language Models (LLMs) concise code generation abilities in 60 programming languages. Based on code golf, a recreational programming competition focused on minimal character or byte solutions, the benchmark provides a distinctive measure of LLMs ability to produce efficient, concise code. Unlike existing benchmarks limited by fixed problem sets and language coverage, CodeGolf Bench leverages the code.golf platform to provide new problems and live human performance baselines. Evaluation of nine LLMs on Python and C++ tasks demonstrates that reasoning models significantly outperform non-reasoning models, achieving best average percentile of 70.97%. This performance gap is particularly pronounced in C++, highlighting reasoning's importance for languages with strict syntax requirements. Non-reasoning models struggle more with efficiency optimization across both languages, with best percentiles significantly lower than reasoning counterparts. CodeGolf Bench offers a dynamic framework for evaluating LLM code generation capabilities against evolving human performance on code golf.},
}

@article{brahman2026codequal,
  title = {CodeQual: Learning Code Quality Assessment from Synthetic LLM Annotations},
  author = {Danny Brahman and Mohammad Mahoor},
  year = {2026},
  pages = {541--545},
  doi = {10.1109/icnlp69856.2026.11527897},
  url = {https://doi.org/10.1109/icnlp69856.2026.11527897},
  keywords = {code quality assessment, CodeBERT, lightweight language models, readability, inter-annotator agreement, pre-trained code models, CI/CD integration},
  abstract = {Code quality is inherently subjective, encompassing dimensions like readability, efficiency, and adherence to language idioms that traditional static metrics fail to capture adequately. While large language models (LLMs) can assess these subjective qualities, lightweight models offer practical advantages: seamless CI/CD pipeline integration, lower operational costs, and full control over model behavior. We investigate whether such models can learn to assess code quality by training on synthetic LLM annotations. We introduce CodeQual, a dataset of $\mathbf(5, 8 1 9)$ code samples derived from five established sources spanning diverse domains-competitive programming, pedagogical problems, software engineering, and general benchmarks-scored by LLMs across five quality dimensions, with 655 human-annotated samples for evaluation. Our fine-tuned CodeBERT model not only matches LLM performance but exceeds inter-human agreement on all five dimensions, achieving 16-100 % improvement over the interhuman agreement baseline. This result suggests that models trained on synthetic LLM annotations learn to predict aggregated human consensus more consistently than individual annotators agree with each other. Our findings establish code quality assessment as a viable downstream task for pre-trained code models and demonstrate that synthetic LLM annotations provide effective training data for developing practical, deployable code quality assessment tools.},
}

@article{kasthala2026codesentinal,
  title = {codesentinal-dataset},
  author = {Vamsridar Kasthala},
  journal = {Mendeley Data},
  year = {2026},
  doi = {10.17632/txydn848cd},
  url = {https://doi.org/10.17632/txydn848cd},
  keywords = {AI-generated code detection, C source code, code classification, large language models, open-weight LLMs, code generation models},
  abstract = {This dataset contains labeled C++ source code snippets curated to evaluate machine learning and deep learning models for distinguishing between human-written and AI-generated code. Each entry includes the raw source code (code), the specific generating model or human source (generator), a binary ground-truth label (label: 0 for human-written, 1 for AI-generated), and the programming language (language). The AI-generated samples span multiple open-weight Large Language Models (including Qwen2.5-Coder, DeepSeek-Coder, CodeLlama, Llama-3 series, StarCoder2, Phi-3 series, Yi-Coder, CodeGemma, and Granite-8B), paired with human-written competitive programming and algorithmic implementations.},
}

@article{le2026codifying,
  title = {Codifying a Tacit Tradition: A Position Paper on the elix-researches Program for Vietnamese Chuyên Tin / IOI-Pipeline Pedagogy},
  author = {That Le},
  journal = {Zenodo (CERN European Organization for Nuclear Research)},
  year = {2026},
  doi = {10.5281/zenodo.20131536},
  url = {https://doi.org/10.5281/zenodo.20131536},
  publisher = {European Organization for Nuclear Research},
  keywords = {tacit knowledge, ACT-R, problem generation, Codeforces, China Seismo-Electromagnetic Satellite},
  abstract = {Vietnam has placed at the International Olympiad in Informatics every year since 1989 [1] and operates a national network of seventy-seven specialised informatics (chuyên Tin) classes feeding the pipeline — an elite sliver of order 103 active students per cohort year, less than ∼ 0.01% of the MOET Circular 32/2018 Tin học population. This paper is about that sliver, not the general K-12 population. The pedagogy that produces the country's IOI result is carried almost entirely as practitioner-tacit knowledge in textbooks, on the VNOI wiki, and through an alumni-mentor network; a Scopus / Web of Science / VCGate scan of Vietnamese- and English-language venues over 2000–2025 (documented in M1 §M1.2) returns no peerreviewed publication of its theory or its evidence base. This paper introduces elix-researches, a theoretical, document-analytic, and simulation research program whose object of study is precisely this tradition — chuyên Tin / VNOI / IOI-pipeline pedagogy — viewed under a competitive-programming lens. The program does no cohort work, does not touch minors, and does not gate execution on legal or regulatory review; admissible methods are documentary, corpus-analytic, simulative, LLM-in-the-loop, expert-adult elicitation, and meta-analytic. We commit, here and explicitly, to the chuyên Tin / IOI-pipeline target population under ADR‐002‐target‐population‐commitment.md, and bracket the broader Layer-C non-chuyên question as deferred (not denied; reversibility conditions codified in the ADR). We name the program's first-mover contribution as a four-layer novelty stack: a Vietnamese-canon ↔ IOI Syllabus 2024 crosswalk (N1), a four-way comparative pedagogy matrix across Vietnam / USACO / CSES / Codeforces (N2), a variation-axis coverage schema operationalised against VNOJ (N3), and — conditional on T3 resolution and pending ADR-001 ratification in the V1.5 subproject — the Spine-Cluster framework for Layer-D proceduraltuning under Anderson ACT-R + Chi-Glaser + Ericsson bounds (N4, forthcoming). The empirical surface is novel-problem generation through an LLM-in-the-loop pipeline (E4.2), expertadult elicitation against IOI alumni and chuyên coaches, and Spine-Cluster simulation under BKT / ACT-R-grounded learner models. We position the program against Vietnamese literature (sparse, practitioner-dominated, no programmatic line on K12 informatics pedagogy) and international literatures (CSTA, CAS / PRIMM, Brennan-Resnick, Olympiads in Informatics) and report three honest seams: the T-1 target-population question (now resolved by commitment), the T-2 memoised-recursion /},
}

@article{arun2026com,
  title = {COM: A Framework for Hallucination Reduction and Reasoning Enhancement of LLMs in Zero-Shot Code Generation},
  author = {Piyush Kumar Arun and Anu Mary Chacko},
  journal = {IEEE International Conference on Recent Advances in Electronics, Communication, Computing, Automation and Power (RECCAP)},
  year = {2026},
  pages = {1--7},
  doi = {10.1109/reccap69368.2026.11724074},
  url = {https://doi.org/10.1109/reccap69368.2026.11724074},
  publisher = {Institute of Electrical and Electronics Engineers},
  keywords = {hallucination mitigation, large language models, multi-agent systems, data structures and algorithms, code verification, self-correction},
  abstract = {Recent advances in Large Language Models (LLMs) have enabled increasingly complex code generation with high syntactic fluency. Despite this, LLMs frequently hallucinate—producing code that appears logically correct yet fails during execution or mishandles critical edge cases. This limitation is particularly severe for Data Structures and Algorithms (DSA) problems, where execution-level correctness and reasoning consistency are essential. This paper presents COM (Cost-efficient Open-source Multi-agent), a framework that mitigates hallucinations and enhances reasoning reliability in zero-shot code generation, and GenEval, an industry-oriented DSA benchmark curated from competitive programming platforms and real-world practitioner problems, publicly released on HuggingFace. COM decomposes code generation into four specialized agents—Creator, Critic, Verifier, and Refiner—coordinated through an execution-grounded critique–verification–refinement cycle to approximate self-corrective behavior absent in single-pass systems. Evaluated on HumanEval and GenEval using Pass@k and hallucination rate, COM achieves an 8.05% Pass@k improvement with 34.87% relative hallucination reduction on HumanEval, and 5.77% improvement with 27.37% reduction on GenEval. GenEval is established as a reproducible benchmark for systematic evaluation of reasoning failures in code-centric LLM applications, and has been adopted by 18+ researchers within three weeks of its public release.},
}

@article{zhang2026combench,
  title = {ComBench: A Benchmark for Rigorous Proof Reasoning and Constructive Realization in Olympiad-Level Combinatorics},
  author = {Shunkai Zhang and Haoran Zhang and Yun Luo and Qianjia Cheng and Haodi Lei and Yizhuo Li and Runzhe Zhan and Zhilin Wang and Bangjie Xu and Yucheng Su and Xinmiao Han and Xiaoye Qu and Dongrui Liu and Zhouchen Lin and Yu Qiao and Ning Ding (456674) and Yafu Li and Yu Cheng},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2606.10479},
  url = {https://doi.org/10.48550/arxiv.2606.10479},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {large language models, mathematical problem solving, Kimi, GPT-5.5},
  abstract = {Combinatorics is central to Olympiad-level mathematical problem solving, requiring deep discrete reasoning, creative constructions, and rigorous structural insight. Recent evidence suggests that even today's strongest frontier models remain uneven on Olympiad combinatorics, revealing a gap in creative mathematical reasoning. We introduce ComBench, an Olympiad-level combinatorics benchmark for evaluating and diagnosing the combinatorial reasoning capabilities of large language models. ComBench contains 100 human-annotated competition-level problems organized around two complementary settings: analysis-centric problems, which primarily require rigorous mathematical arguments, and construction-centric problems, which require explicit constructions in addition to correctness justifications. The evaluation protocol combines rubric-guided proof grading with deterministic construction verification, exposing cases where proof quality and construction validity diverge. Experiments on frontier open- and closed-source models show that ComBench is far from saturated: the strongest model reaches 65.4% overall Avg. and 75.3% overall Best@4. We further find that Rigorous Proof Reasoning and Constructive Realization are distinct capabilities: Kimi-K2.6 trails GPT-5.5 on analysis-centric proof grading but surpasses it on construction-centric Best@4, while Existence and Construction problems remain consistently hardest across representative frontier models.},
}

@article{tuna2026consensus,
  title = {Consensus Ensembles for Zero-Shot Algorithm Classification with Large Language Models},
  author = {Haydar Tuna and Sefa Akca and Taymaz Akan},
  journal = {Electronics},
  year = {2026},
  volume = {15},
  pages = {4548},
  doi = {10.3390/electronics15194548},
  url = {https://doi.org/10.3390/electronics15194548},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2079-9292},
  keywords = {algorithm classification, zero-shot classification, large language models, algorithmic paradigms, inter-rater reliability, consensus aggregation, disagreement resolution, calibration, pairwise ranking, Borda count, competitive programming},
  abstract = {Manual classification of algorithmic problems is costly and inconsistent, although it remains essential for curriculum sequencing, recommendation systems, and quality control on competitive programming platforms. To address this limitation, this study investigates whether consensus-based, zero-shot classification using large language models can replace manual annotation. Five architecturally diverse models were evaluated: Claude Sonnet v4.6 (CS4.6), DeepSeek v3.2 (DS3.2), Gemini v3 Flash (G3F), GPT v5.4 (GPT5.4), and Grok v4.1 Fast (GRK4.1). Each model independently classified 2911 LeetCode problems into 13 mutually exclusive algorithm categories to generate predicted labels and confidence vectors. These outputs served as the basis for systematically comparing eight consensus aggregation methods and five disagreement-resolution strategies. The five-model ensemble achieved at least 4/5 agreement on 85.3% of the problems, demonstrating substantial overall inter-rater reliability. While consensus weakened as problem difficulty increased, it was notably lowest for the Algorithmic Paradigms group because category boundaries depend on computational properties that are not directly visible in source code. Six aggregation methods converged within a narrow 90.0–90.1% average-agreement band. A Friedman omnibus test with Holm–Bonferroni-corrected pairwise comparisons showed that this band separates further into two statistically distinguishable trios differing by only 0.07–0.08 percentage points, illustrating that statistical significance at this sample size does not imply practical importance. An unsupervised adaptation of pairwise ranking from LLM-Blender reached 89.1%, whereas Borda Count underperformed at 83.1%. Among disagreement-resolution strategies, progressive ensemble pruning proved most effective by resolving 92.5% of cases. Calibration varied substantially across the panel, with GPT5.4 showing the largest calibration gap (0.124) and GRK4.1 showing the smallest (0.023). This variation suggests that confidence-weighted aggregation is effective only when applied selectively to well-calibrated models. These findings support consensus-based ensembles of these five models as a scalable alternative to manual algorithmic annotation and provide actionable guidance for designing robust aggregation pipelines in unsupervised settings.},
}

@article{kaluski2026contextualizing,
  title = {Contextualizing Beginner Programming Exercises with Small Language Models},
  author = {Daniel Kaluski and Lukas Ahrenberg and Juho Leinonen},
  journal = {Koli Calling International Conference on Computing Education Research},
  year = {2026},
  pages = {1--7},
  doi = {10.1145/3856208.3856248},
  url = {https://doi.org/10.1145/3856208.3856248},
  publisher = {Association for Computing Machinery},
  keywords = {small language models, programming for beginners, exercise generation, local inference, student learning interest, prompting strategies, model size, introductory programming education},
  abstract = {Contextualized programming exercises can make abstract introductory programming tasks feel more meaningful, but manually adapting exercises for many learner interests does not scale. Large language models can generate or rewrite exercises, yet their use can introduce privacy, cost, and infrastructure concerns when student data or preference profiles are sent to external services. This paper investigates whether small language models that can be run locally are capable of contextualizing beginner programming exercises while preserving the original learning objective. We evaluated 1,260 contextualized exercises created by 13 small language model variants and one commercial large language model baseline. The design crossed five beginner programming exercises, three learner-interest contexts, three prompting strategies, and two runs per condition. Outputs were manually rated using four rubric dimensions: context presence, context relevance, goal preservation, and clarity. The results show that several small models, especially mid-sized general-purpose Qwen3 models, received context-presence and context-relevance ratings similar to those of the commercial baseline in this evaluation. However, output quality varied substantially across model families and exercises, and ratings for paired generations showed some run-to-run variation. The evaluated code-specialized models generally received less favorable ratings than the general-purpose models, and ratings did not improve consistently with model size.},
}

@article{ho2026cppperfa,
  title = {CppPerf: An Automated Pipeline and Dataset for Performance-Improving C++ Commits},
  author = {Tommy Ho and Khashayar Etemadi and Zhendong Su},
  journal = {IEEE/ACM International Conference on Automated Software Engineering (ASE)},
  year = {2026},
  pages = {3415--3419},
  doi = {10.1145/3832783.3834606},
  url = {https://doi.org/10.1145/3832783.3834606},
  keywords = {performance benchmarking, OpenHands},
  abstract = {Recent progress in automated repair of performance bugs demands realistic, executable benchmarks. However, existing C++ performance benchmarks are largely built from competitive programming submissions, and recent real-world benchmarks predominantly target Python and .NET. To fill this gap, we present CppPerf-Mine, a configurable pipeline that mines execution-time-improving patches from open-source C++ repositories on GitHub by combining structural commit filtering, an LLM-based commit classifier, and a containerized build & test stage that produces fully reproducible Docker images for each patch. Using CppPerf-Mine, we build CppPerf-DB, a benchmark comprising 347 manually verified patches from 42 mature C++ repositories, 39% of which are multi-file, enabling the evaluation of repository-level repair tools. In our preliminary study, OpenHands correctly fixes only 13.5% of the patches in CppPerf-DB, confirming that real-world C++ performance repair remains an open challenge. CppPerf-Mine and CppPerf-DB are open-source and publicly available at: https://doi.org/10.5281/zenodo.20097425. In addition, a demonstration video is available at: https://www.youtube.com/watch?v=nixlupIgSdM.},
}

@article{yousefian2026design,
  title = {Design of an LLM-Powered Interactive Tutor for Programming Exercises},
  author = {Negar Yousefian},
  journal = {Aaltodoc (Aalto University)},
  year = {2026},
  url = {https://aaltodoc.aalto.fi/handle/123456789/147231},
  publisher = {Aalto University},
  keywords = {programming education, novice programmers, programming exercises, AI-assisted learning},
  abstract = {Nowadays, learning programming requires having multiple skills at the same time, such as knowledge of programming languages, problem-solving, and debugging. Therefore, the students who face this challenge tend to seek support from AI tools without critically evaluating the results that those tools generate. Moreover, the current AI tools are mostly focusing on improving developers’ productivity rather than the pedagogical value they provide for novice programmers and students. Hinthub is a PoC of an LLM-based interactive tutor following a three-tier design architecture to address this gap. In this web-based system, the students will receive either cursor-sensitive correct or deliberately wrong suggestions with equal probability, so they need to carefully evaluate those before taking an action. They will also receive immediate feedback after accepting or rejecting the AI-generated suggestions. In order to evaluate the effectiveness and usability of the system, a study was performed with 40 students of Aalto University, each enrolled in the “Web Software Development” introductory course. The results of the study showed that the correct action ratio per student was about 63% overall. This ratio improved from the first exercise, from almost 56% to 64% in the last exercise, which can be due to the students’ critical evaluation improvements. Moreover, the outcome of the short survey was moderate since the students found the study a helpful learning activity; however, they were closer to neutral about whether the system helped them distinguish correct and incorrect suggestions. Also, the end-of-study survey results score was around 61, which is below the commonly accepted threshold of 68. This score may be increased by reducing AI response latency, adding a live code preview, and improving the quality of generated suggestions. Overall, HintHub represents a promising PoC focusing on developing students' critical AI-evaluation skills in a programming education context.},
}

@article{jiang2026distdebug,
  title = {DistDebug-Bench: Can LLM Agents Diagnose Bugs in Distributed Systems?},
  author = {Yuxuan Jiang and 刘成林 and John Rose and Mason Miller and Ruthesh Thavamani and Juntao Wu and Yinwei Huang and Jiahao Xu and Peng Huang},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2611.03523},
  url = {https://doi.org/10.48550/arxiv.2611.03523},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {LLM agents, bug diagnosis, distributed systems, benchmark, failure patterns, tunnel vision, tool use, non-determinism, large language models},
  abstract = {LLM agents show strong potential in software engineering tasks such as competitive programming and code synthesis. Existing benchmarks, however, largely focus on small-scale settings such as self-contained Python modules, leaving distributed systems, an essential class of production software, under-examined. We introduce DistDebug-Bench, a benchmark for evaluating agents' ability to diagnose complex-system failures at the code level. It curates 120 high-quality real-world bugs from 11 widely used distributed systems, spanning 5 programming languages and 10 failure patterns. Through an extensive evaluation of state-of-the-art LLMs and agents, we identify substantial gaps between current agents and real-world debugging tasks. A recurring gap is tunnel vision due to a lack of explicit reasoning structure and nondeterminism from inconsistent tool-use scope. The benchmark and evaluator are available at https://github.com/OrderLab/distdebug-bench, with agent traces and a leaderboard at https://distdebug.com.},
}

@article{negueruela2026dual,
  title = {Dual-Process Neuro-Symbolic Cognitive Architecture for Zero-Token Program Synthesis via Hyperdimensional Associative Resonance},
  author = {Hugo Múgica Negueruela},
  journal = {Zenodo (CERN European Organization for Nuclear Research)},
  year = {2026},
  doi = {10.5281/zenodo.22848849},
  url = {https://doi.org/10.5281/zenodo.22848849},
  publisher = {European Organization for Nuclear Research},
  keywords = {neuro-symbolic AI, hyperdimensional computing, program synthesis, on-device inference, associative memory, Hebbian plasticity, LLM hallucination, competitive programming, mathematical reasoning, spatial logic, domain-specific languages, SIMD acceleration, MATH-500},
  abstract = {Current foundation models (Large Language Models, LLMs) dominate automated software engineering and code generation, but they suffer from severe energy inefficiencies, recurrent token latency (2,000–10,000 ms per inference), non-deterministic hallucination, and lack of persistent lifelong memory. Biological cognitive systems, by contrast, employ a rapid, sub-conscious associative memory (System 1) to resolve familiar recurring challenges, invoking deliberate, resource-intensive deliberation (System 2) strictly when novel epistemic uncertainty is encountered. In this work, we present Oscurus, an asynchronous, dual-process neuro-symbolic cognitive architecture designed for continuous, on-device algorithmic synthesis. System 1 is anchored by a high-performance Hyperdimensional Computing (HDC / Vector Symbolic Architectures) substrate operating in D = 10,000 dimensions with native SIMD hardware acceleration (POPCNT, achieving 6.35 million bitwise operations per second). Structural algorithmic archetypes and Abstract Syntax Tree (AST) primitives are mapped into orthogonal hypervectors. When incoming problem specifications match consolidated Hebbian memory states above an adaptive certainty threshold, System 1 synthesizes and executes verified code in 5–15 ms with zero LLM tokens and zero GPU VRAM consumption. If epistemic certainty indicates high topological novelty, the system orchestrates a reflective System 2 query to a generative foundation model. Validated solutions produced by System 2 are subsequently distilled into System 1 via associative Hebbian plasticity, systematically expanding the offline zero-token boundary. Across comprehensive empirical evaluations on major competitive programming, mathematical, and inductive benchmarks: 1. Full Program & Patch Synthesis: 100.0% validation pass rate on OpenAI HumanEval (164/164) and 100.0% on modular SWE-bench Lite challenges (15/15). 2. Mathematical & Multitask Reasoning: 71.6% on GSM8K (662/924), 38.2% on MATH-500 (191/500, verified via formal symbolic algebra), and 46.4% on MMLU (210/453). 3. Zero-LLM Spatial Logic: Autonomous DSL-based synthesis on François Chollet's ARC-AGI benchmark with 100% zero-LLM reliance on solved tasks. 4. Extreme Latency & Throughput: Hardware-accelerated System 1 operations demonstrate a >200× speedup over cloud-based foundation model invocations.},
}

@article{katai2026ecn,
  title = {ECN AI Baseline Index 2024: A Stable and Accessible AI Performance Indicator Across Difficulty Shifts},
  author = {Zoltán Kátai and Dávid Iclănzan},
  journal = {Acta Universitatis Sapientiae Informatica},
  year = {2026},
  volume = {18},
  pages = {17},
  doi = {10.1007/s44427-026-00033-8},
  url = {https://doi.org/10.1007/s44427-026-00033-8},
  publisher = {De Gruyter Open},
  issn = {1844-6086},
  keywords = {large language models, competitive programming, programming competition},
  abstract = {We present the 2024 edition of the ECN AI Baseline Index (EAII), an accessible benchmark evaluating large language models in competitive programming under contest conditions. The universities division of the 2024 Sapientia–ECN (Efficiency, Challenge, Networking) programming contest included 11 teams and 16 university-track problems and introduced a judging platform restricted to C/C++/Pascal. Using a simple C++ prompting protocol with limited feedback rounds, the AI fully solved 13 of 16 problems (81.25%), partially solved two, and failed on one interactive task. Student teams achieved a median of nine and a maximum of twelve solved problems. The resulting 2024 EAII value is 125%. We provide per-problem and team-level analyses, along with figures summarizing score distributions, problem-specific solve rates, and year-over-year comparisons with 2023. Despite a markedly easier contest and a shift in the AI language channel (C++ versus Python), EAII remains stable relative to 2023, supporting the robustness of the normalization procedure. Interpretation is reserved for the Discussion; this paper focuses on methodology, descriptive analyses, and numerical results.},
}

@article{castaldo2026editorial,
  title = {Editorial: From the heart of the athlete to athlete's heart to cardiopathy: approaches and challenges in risk management in cardiovascular sports medicine},
  author = {Clotilde Castaldo and Franca Di Meglio and Daria Nurzyńska},
  journal = {Frontiers in Cardiovascular Medicine},
  year = {2026},
  volume = {13},
  pages = {1953095},
  doi = {10.3389/fcvm.2026.1953095},
  url = {https://doi.org/10.3389/fcvm.2026.1953095},
  publisher = {Frontiers Media},
  issn = {2297-055X},
  keywords = {athlete's heart, sports cardiology, cardiovascular risk management, exercise-induced cardiac remodeling, endurance training, marathon runners, galectin-3, electrocardiographic criteria, cardiac magnetic resonance, echocardiography, shared decision-making, individual risk assessment, sudden cardiac death},
  abstract = {progressive increase in pressure overload that can lead to concentric hypertrophy, and endurance training common in aerobic sports, in which dynamic exercise reduces total peripheral resistance and enhances venous return, creating a volume overload that can result in eccentric hypertrophy, associated with decreased end-systolic volume, increased stroke volume, and electrical adaptations such as sinus bradycardia. Based on the above features, diagnostic imaging with functional measurements allows clinicians to identify a broad spectrum of heart conditions in athletes with great accuracy. However, understanding the continuum from normal physiological adaptation to pathological cardiomyopathy reflects a broader evolution in sports cardiology, which acknowledges that regular physical activity is among the most effective interventions for preventing and treating cardiovascular disease and thus aims at distinguishing between "safe" and "problematic" in order to support sport participation rather than simply enforcing medical restrictions (2). This Research Topic highlights the modern approach, which is based on diagnostic evidence, personalized risk management and shared decision-making (3).The cardiovascular response to exercise is one of the most remarkable examples of biological adaptation. Regular training produces characteristic structural and functional cardiovascular remodeling that enables the cardiovascular system to meet increased physiological demands during exercise (4). Not surprisingly, the concept of the athlete's heart has become a key topic in sports medicine. Indeed, as participation in sport continues to increase across different age groups, disciplines, and competition levels, clinicians face a major challenge: distinguishing physiological adaptation from pre-existent or early cardiovascular disease. The six studies included in this collection demonstrate that exercise-induced cardiovascular adaptation is not simply normal or abnormal. Instead, it represents a continuum influenced and shaped by training volume, age, sex, genetics, and individual traits. Together, these contributions support a modern approach based on accurate assessment, consistent follow-up, and personalized clinical decision-making. Endurance sports present additional diagnostic challenges because intense physiological stress can produce extensive structural, functional, and electrical remodeling, accompanied by temporary changes that overlap with pathological findings and resemble cardiovascular disease (4). In the study by Lasocka-Koriat et al. in amateur marathon runners, extreme physical strain caused transient structural and functional changes, as assessed by echocardiography, as well as biochemical alterations, with Galectin-3 increase correlating with reversible functional decline. Interestingly, different responses were observed in male and female athletes. These findings show that cardiovascular responses to intense exercise are dynamic and reversible, while also emphasizing the need to identify athletes who require further clinical evaluation.As athletes grow older, cardiovascular screening becomes more complex and challenging, as longterm training adaptations overlap with age-related changes and a higher risk of acquired heart disease. Re-evaluating ECG criteria in master (over 35 years-of-age) competitive athletes highlights the importance of refining screening tools to maintain an appropriate balance between sensitivity and specificity in all age groups. The retrospective study by Halasz et al. showed that the Seattle criteria demonstrated higher overall accuracy, with significantly better discriminative performance than the International criteria, and a lower false-positive rate compared with the ESC criteria for diagnosis of conditions at risk of sudden cardiac death.Hypertrophic cardiomyopathy has traditionally led to major restrictions in competitive sports participation because of concerns about ventricular arrhythmias and sudden cardiac death. However, recent evidence supports a more personalized approach. The meta-analysis by Borrelli et al., included in this Research Topic, showed that structured exercise in carefully selected individuals with hypertrophic cardiomyopathy does not increase the risk of major adverse cardiovascular events and improves cardiorespiratory fitness. These cases highlight the value of multidisciplinary evaluation involving sports cardiologists, geneticists, imaging specialists, and long-term follow-up. This paradigm shift is reflected in updated international guidelines, which now recognize that universal restriction from vigorous exercise is not warranted for most patients with hypertrophic cardiomyopathy (5,6).Furthermore, the cases of elite female athletes carrying pathogenic variants associated with Duchenne muscular dystrophy, analyzed by Wernhart et al., illustrate the challenges of evaluating athletes with a possible inherited risk of myocardial disease. Female carriers may have no clinical symptoms while still being at risk of myocardial involvement, raising important questions about the interaction between genetic predisposition and long-term exposure to high-intensity exercise.Overall, the studies included in this Research Topic show that the future of sports cardiology goes beyond classifying athletes as either healthy or diseased. Exercise-induced cardiovascular remodeling occurs along a continuum and its correct interpretation requires the integration of clinical history, imaging, biomarkers, and genetics. Future developments in cardiovascular sports medicine will increasingly rely on precision medicine to identify individual risk while avoiding unnecessary restrictions on physical activity. Integrating advances in multimodality imaging, molecular biomarkers, and genomic medicine is expected to improve the ability to distinguish physiological adaptation from cardiovascular disease and to support more personalized exercise recommendations.},
}

@article{raed2026prompt,
  title = {EL's Prompt Engineering},
  author = {EL ALI RAED},
  journal = {Zenodo (CERN European Organization for Nuclear Research)},
  year = {2026},
  doi = {10.5281/zenodo.24344226},
  url = {https://doi.org/10.5281/zenodo.24344226},
  publisher = {European Organization for Nuclear Research},
  keywords = {prompt engineering, large language models, system prompts, context engineering, retrieval-augmented generation, AI agents, tool calling, prompt security, hallucination mitigation, model evaluation},
  abstract = {**EL's Prompt Engineering: From Instructions to Intelligent Systems** *First Edition — 2026 | By Ali Raed* EL's Prompt Engineering is a practical, engineering-oriented guide to designing, developing, and evaluating intelligent systems powered by large language models (LLMs). Across 96 pages and 12 chapters, the book explores prompt engineering beyond conventional instruction writing, presenting it as an essential discipline within modern AI engineering. Topics covered include: - Large Language Models and their underlying principles.- Fundamental and advanced prompt engineering techniques.- System prompts and model behavior.- Context engineering and Retrieval-Augmented Generation (RAG).- AI agents, tool calling, and intelligent workflows.- Prompt security, safety, and hallucination mitigation.- Model evaluation, performance optimization, and real-world AI applications. The book includes practical examples, programming exercises, technical references, and a dedicated case study exploring the development of EL.ai, a bilingual AI application created by the author. Written from the perspective of a software engineering student at the University of Babylon with a focus on artificial intelligence engineering, this book bridges theoretical concepts and practical software development. Designed for students, developers, aspiring AI engineers, and technology enthusiasts, it provides a structured foundation for building more reliable, secure, and effective AI-powered systems. *A prompt defines intent. Engineering makes that intent reliable.*},
}

@article{liu2026empirical,
  title = {Empirical Study of Process Reward-Guided Model Ensemble for Edge Reasoning},
  author = {Yide Liu and Yuqi Wu and Shengming Zhao and Tianyi Ye and Jie Chen},
  journal = {IEEE International Symposium on Circuits and Systems proceedings},
  year = {2026},
  pages = {1849--1853},
  doi = {10.1109/iscas66217.2026.11562617},
  url = {https://doi.org/10.1109/iscas66217.2026.11562617},
  publisher = {Institute of Electrical and Electronics Engineers},
  issn = {0271-4302},
  keywords = {ensemble learning, process rewards, dynamic resource allocation, large language models, beam search, small language models, multi-step reasoning, GSM8K, coordination overhead},
  abstract = {Deploying Large Language Models (LLMs) for multi-step reasoning on edge devices faces significant challenges due to limited computational resources and memory constraints. While ensemble methods show promise, fixed resource allocation strategies—such as uniform beam distribution or simple majority voting—often under-utilize heterogeneous model capabilities. We empirically revisit process reward-guided dynamic allocation under resource-constrained settings, examining how step-wise feedback can inform efficient compute distribution across small models (0.5B-1.8B parameters) during beam search. Our study evaluates this approach on GSM8K (grade-school math problems) and MATH500 (competition-level mathematics), achieving 82.56% and 52.2% accuracy respectively. Bootstrap significance testing (10,000 iterations) confirms statistically significant improvements of 0.6% on GSM8K (p=0.038) and 3.6% on MATH500 (p=0.045) compared to fixed allocation baselines. This work provides empirical insights into the trade-offs between coordination overhead and inference quality in small-model ensembles.},
}

@article{li2026enhancing,
  title = {Enhancing competitive-level code generation by utilizing natural language reasoning},
  author = {Jierui Li},
  journal = {Texas Digital Library (University of Texas)},
  year = {2026},
  doi = {10.26153/tsw/65077},
  url = {https://doi.org/10.26153/tsw/65077},
  publisher = {The University of Texas at Austin},
  keywords = {competitive programming, automatic code generation, large language models, natural language reasoning, comparison of solutions, LLM agents},
  abstract = {Large language models have substantially advanced automatic code generation, but competitive programming remains a demanding test of their reasoning abilities. Solving these problems requires more than producing syntactically valid code: a model must abstract a narrative specification into its underlying mathematical structure, discover an efficient algorithm, develop the algorithm into a complete plan that accounts for correctness, complexity, and edge cases, and finally translate the plan into an executable program that succeeds on unseen tests under strict resource constraints. This complex process requires strategy exploration and problem-solving skills, and is beyond implementing straightforward functionalities. Human competitors typically develop these skills through algorithmic principles, worked examples, and expert-written editorials rather than through problem--program pairs alone. This thesis proposes to utilize natural language as an intermediate representation between problem understanding and reliable program synthesis. This thesis investigates how to leverage and improve LLMs’ abilities in natural-language reasoning, specifically in the context of solving competitive-level programming problems. It first decomposes competitive programming problem-solving into strategy discovery, specific verbal solution details, and implementation. Across the evaluated settings, large language models can often explain verified human solutions and implement programs from detailed verbal descriptions even when they struggle to solve the same problems directly. These results suggest that the main bottleneck lies less in translating a complete solution into code than in discovering the correct algorithmic strategy and specifying it with sufficient precision. Building on this diagnosis, the thesis develops an explanation-based distillation framework that first automatically generates editorial-style reasoning from verified human programs and uses these explanations to teach a separate reasoning model to guide code generation on new problems. The findings show that semantically rich natural-language supervision transfers algorithmic knowledge more effectively than directly training in the problem-to-code setting and encourages the use of more efficient strategies rather than superficial or brute-force implementations. The thesis then introduces CodeTree, which operationalizes the separation of reasoning and implementation through an agent-guided search process: distinct roles propose strategies, implement programs, diagnose failures, and evaluate candidate solutions, while execution evidence and model-generated critique determine whether a search path should be expanded, revised, discarded, or accepted. This study finds that exploring diverse strategies and making informed search decisions are generally more effective than repeatedly refining a single initial solution, although successful role decomposition depends on the underlying model's ability to follow specialized instructions. The thesis next examines whether stronger problem-solving performance implies transferable algorithmic understanding. AlgoSimBench evaluates whether models can recognize problems that share an underlying solution method despite differences in wording and narrative context, and demonstrates that solving individual programming tasks and recognizing reusable algorithmic structure are distinct capabilities. The results also show that comparing generated solution attempts can expose algorithmic structure more clearly than comparing raw problem statements, even when the attempted solutions are not fully correct. Finally, the thesis extends this investigation to code retrieval through InstEmbed, an instruction-sensitive representation-learning framework in which the desired target, definition of similarity, and relevant portion of the query jointly determine what should be retrieved. By contrasting documents that are related to the same query but valid under different instructions, the framework learns to distinguish general semantic relevance from task-specific usefulness and improves both target-aware and noise-robust retrieval. Together, these studies establish natural language as a practical intermediate representation for learning, exploring, evaluating, and retrieving algorithmic knowledge, bridging the gap between problem and code, while showing that reliable code generation requires explicit attention to both the structure of the reasoning process and the generalizability of the representations it produces.},
}

@article{le2026evaluating,
  title = {Evaluating AI-mediated Tutors for Competitive-Programming Training: A Position Paper on Prompt-Family Ablation and Rubric Design},
  author = {That Le},
  journal = {Zenodo (CERN European Organization for Nuclear Research)},
  year = {2026},
  doi = {10.5281/zenodo.20131498},
  url = {https://doi.org/10.5281/zenodo.20131498},
  publisher = {European Organization for Nuclear Research},
  keywords = {competitive programming, rubric development, Bayesian Knowledge Tracing, algorithmic composition, knowledge compilation},
  abstract = {Large language models are routinely deployed as tutors in introductory programming (CS1/CS2), and an evaluation literature has emerged around that surface. Competitiveprogramming (CP) olympiad preparation, in contrast, presents a qualitatively different tutoring problem: multi-step algorithmic composition, tight complexity budgets, and adversarial problem framing. No peer-reviewed study evaluates LLM tutors against CP olympiad learners or against a milestone-differentiated cognitive model of CP skill acquisition. This position paper makes three contributions. First, it argues that the CP-tutor evaluation slot is structurally distinct from the CS1-tutor evaluation slot and cannot be filled by extrapolation. Second, it proposes a five-axis rubric (correctness, pedagogical fit, transcript coherence, bias behaviour, Bloom alignment) that extends the four-axis variation schema used in sister work on CP-problem generation. Third, it specifies a three-prompt-family ablation design, one family per knowledge-compilation milestone (L3 strategy retrieval, L4 algorithm adaptation, L5 complexity reasoning), together with a two-channel evidence plan (a Bayesian-Knowledge-Tracing simulated learner and an adult-proxy role-play protocol) that respects a post-pivot admissibility regime excluding K-12 subjects. The paper is positioned as the tutor-side complement to an existing CP-problem-generator methodology, sharing the variation-axis backbone, the pre-registration discipline, and the LLM-as-judge bias-control frame.},
}

@article{goodwin2026evaluating,
  title = {Evaluating LLM-Generated Contextualized Algorithm Design Problems},
  author = {Erica Goodwin and Katherine Braught and Jonathan Liu and Dip Kiran Pradhan Newar and Yael Gertner and Seth Poulsen and Diana M. Franklin},
  journal = {ACM Conference on International Computing Education Research (ICER)},
  year = {2026},
  pages = {407--421},
  doi = {10.1145/3765964.3811658},
  url = {https://doi.org/10.1145/3765964.3811658},
  publisher = {Association for Computing Machinery},
  keywords = {large language models, introductory programming education, prompt engineering, problem generation, model selection},
  abstract = {Background: Context personalization, the practice of adapting learning materials to students’ personal interests, has been shown to increase student learning and engagement. Within computer science education, research has found that LLMs can generate high-quality contextualized introductory programming exercises. Objective: In this paper, we evaluate the capability of LLMs to generate technically correct and thematically integrated contextualized algorithm design problems. Methods: In a series of three iterative studies, we use LLMs to generate contextualized algorithm design problems from a given base problem and theme, evaluating over 500 generated problems for technical and thematic alignment. Results: We find that LLM-generated algorithm design problems exhibit significantly more issues than prior work has found for introductory programming problems. We identify issues specific to the algorithm design context and then mitigate these issues with prompt engineering techniques and model choice. With these adjustments, we produce LLM-generated contextualized algorithm design problems that are technically strong, deeply themed, and largely realistic, though realism drops with more culturally and locally specific themes. Implications: We demonstrate a viable workflow for generating contextualized algorithm design problems using LLMs, including prompt design, model selection, and identification of specific issues to review for.},
}

@article{chin2026evaluating,
  title = {Evaluating parameter-free enhancement strategies for LLM-based algorithmic code generation: a comparative study of RAG and TextGrad},
  author = {Wei Hao Chin},
  journal = {DR-NTU (Nanyang Technological University)},
  year = {2026},
  url = {https://hdl.handle.net/10356/235326},
  publisher = {Nanyang Technological University},
  keywords = {large language models, retrieval-augmented generation, competitive programming, program correctness, LiveCodeBench, benchmarking platform, inference overhead},
  abstract = {Large Language Models (LLMs) can generate executable code but remain prone to algorithmic and implementation errors on challenging competitive programming questions. This project evaluates whether Retrieval Augmented Generation (RAG) and TextGrad-based system prompt optimisation improve the correctness of LLM generated Python solutions. A web-based benchmarking platform was developed with retrieval, textual feedback refinement and execution-based evaluation. Six LLMs were evaluated on the same 100 hard problems sampled from LiveCodeBench release_v6 under four configurations: Baseline, RAG-only, TextGrad-only and Combined. The findings showed that RAG provided a modest improvement in solution correctness, while TextGrad-only and Combined configuration did not consistently outperform Baseline. Although both enhancement methods demonstrated improvements on individual problems, their effectiveness varied across models and could also introduce regressions. Furthermore, the additional inference stages introduced substantial computational overhead, particularly for configurations involving TextGrad. These findings provide insights into the effectiveness and limitations of RAG and TextGrad for competitive programming code generation. The developed platform also provides a foundation for further research into LLM enhancement strategies and their effectiveness in competitive programming.},
}

@article{lohiya2026evaluating,
  title = {Evaluating Prompt Engineering Strategies for Reasoning Token Efficiency in Large Language Models},
  author = {Rashi Lohiya and Aaroosh Kurchania and Pranav Anandh and Mihai Boicu},
  journal = {Journal of Student-Scientists' Research},
  year = {2026},
  doi = {10.13021/jssr2026.5630},
  url = {https://doi.org/10.13021/jssr2026.5630},
  publisher = {George Mason University},
  issn = {2689-7679},
  keywords = {prompt engineering, token efficiency, large language models, GPT-5, chain-of-thought prompting, competitive programming},
  abstract = {Large language models have become central to modern software development as 84% of developers now use or plan to use AI tools in their development process (Stack Overflow, 2025). Despite the productivity gains AI tools offer, reasoning models like GPT-5 generate extensive internal thinking traces before producing any output, resulting in high token consumption and costs (OpenAI API Pricing, 2026; CloudZero, 2026). To combat this, prompt engineering has emerged as a promising approach but most existing research optimizes prompts for accuracy alone, leaving the tradeoff between token efficiency and correctness largely unexplored (Shah et al., 2026; Wang et al., 2024). We evaluated 3 prompt types, Structured Chain of Thought, Accuracy-Focused, and No Prompt as a control, using GPT 5 on AtCoder competitive programming problems spanning difficulty ratings from 1000 to 1800, recording both the AtCoder judge verdict and reasoning token count for each run. Across 450 submissions accuracy ranged from 71.3% for No Prompt (avg 2,847 reasoning tokens) to 68.7% for SCoT (avg 2,778 reasoning tokens) and 67.3% for Acc-Focused (avg 2,269 reasoning tokens). McNemar tests revealed no significant improvement in accuracy across prompts, and token comparisons showed no meaningful reduction in token usage. This suggests that for reasoning models like GPT-5, prompts have limited impact on accuracy and token efficiency, motivating future work to isolate the effect of structured prompts on the reasoning process itself, as the internal thinking of reasoning models may respond differently to prompt design than the final output does.},
}

@article{kurchania2026evaluating,
  title = {Evaluating Prompt Engineering Strategies on GPT-5 for Accuracy and Token Efficiency on Competitive Programming Tasks},
  author = {Aaroosh Kurchania and Rashi Lohiya and Pranav Anandh and Mihai Boicu},
  journal = {Journal of Student-Scientists' Research},
  year = {2026},
  doi = {10.13021/jssr2026.5628},
  url = {https://doi.org/10.13021/jssr2026.5628},
  publisher = {George Mason University},
  issn = {2689-7679},
  keywords = {prompt engineering, GPT-5, token efficiency, competitive programming, chain-of-thought prompting, large language models, AI-assisted programming, token cost},
  abstract = {Large language models have become central to modern software development as 84% of developers now use or plan to use AI tools in their development process (Stack Overflow, 2025). Despite the productivity gains AI tools offer, reasoning models like GPT-5 generate extensive internal thinking traces before producing any output, resulting in high token consumption and costs (OpenAI API Pricing, 2026; CloudZero, 2026). To combat this, prompt engineering has emerged as a promising approach but most existing research optimizes prompts for accuracy alone, and doesn’t consider token efficiency (Shah et al., 2026; Wang et al., 2024). We evaluated 3 prompt types, Structured Chain of Thought, Quick Solver, and No Prompt as a control, using GPT 5 on AtCoder competitive programming problems spanning difficulty ratings from 1000 to 1800, recording both the AtCoder judge verdict and the combined cost of all tokens for each run. Across 450 submissions accuracy ranged from 69.3% for No Prompt (avg $0.03905 per problem) to 66.0% for SCoT (avg $0.03927 per problem) and 63.3% for Quick Solver (avg $0.036710 per problem). McNemar tests revealed no significant improvement in accuracy across prompts, and paired t tests showed no meaningful reduction in token cost. This suggests that for reasoning models like GPT-5, prompts have limited impact on accuracy and token efficiency, motivating future work to isolate the effect of structured prompts on the reasoning process itself, as the internal thinking of reasoning models may respond differently to prompt design than the final output does.},
}

@article{cosulschi2026evaluating,
  title = {Evaluating the problem-solving capabilities of modern Large Language Models in competitive programming},
  author = {Mirel Coşulschi and Mihai Gabroveanu and Alexandra Vultureanu‐Albişi and Florin Slabu},
  journal = {Annals of the University of Craiova Mathematics and Computer Science Series},
  year = {2026},
  volume = {53},
  pages = {310--330},
  doi = {10.52846/ami.v53i1.2394},
  url = {https://doi.org/10.52846/ami.v53i1.2394},
  publisher = {University of Craiova},
  issn = {1223-6934},
  keywords = {large language models, competitive programming, problem-solving capacity, programming competition problems, task difficulty, discrimination (statistics), automated grading, acceptance rate, failure patterns, educational assessment},
  abstract = {This paper investigates performance on a dataset of 40 competitive programming tasks designed for formal evaluation in educational settings. The primary objective is to analyze how the performance of problem-solving varies between tasks with differing structure, difficulty, and source, using partial acceptance automated test-based scoring. By examining aggregate performance metrics, task-level difficulty, acceptance rates, failure patterns, and discriminative properties, the study characterizes which types of problem are consistently solvable, which remain challenging, and which most effectively differentiate levels of problem-solving capability. The results reveal substantial variation across tasks, highlighting the influence of task difficulty and structure on acceptance outcomes and demonstrating that medium-difficulty problems tend to provide the strongest discrimination. These findings contribute empirical insight into the characteristics of formally designed Olympiad-style programming problems and their suitability for structured performance assessment in educational and competitive programming contexts.},
}

@article{brahman2026evaluation,
  title = {Evaluation and Distillation of Source Code Generation Tasks by Large Language Models},
  author = {Danny Brahman},
  journal = {Digital Commons - DU (University of Denver)},
  year = {2026},
  doi = {10.56902/etdcrp.2026.69},
  url = {https://doi.org/10.56902/etdcrp.2026.69},
  publisher = {University of Denver},
  keywords = {large language models, code generation, code generation evaluation, code quality assessment, Python programming, benchmark dataset, LLM annotation, lightweight models, concurrency, test suite coverage},
  abstract = {Large Language Models (LLMs) are predominantly assessed based on their common sense reasoning, language comprehension, and logical reasoning abilities. While models trained in specialized domains like mathematics or coding have demonstrated remarkable advancements in logical reasoning, there remains a significant gap in evaluating their code generation capabilities. Existing benchmark datasets fall short in pinpointing specific strengths and weaknesses, impeding targeted enhancements in models’ reasoning abilities to synthesize code. To bridge this gap, this thesis introduces two novel contributions: CodeEval and CodeQual. CodeEval is an innovative, pedagogical benchmarking method that mirrors the evaluation processes encountered in academic programming courses. It comprises a multi-dimensional benchmark dataset of 602 hand-crafted problems designed to rigorously evaluate LLMs across 24 distinct aspects of Python programming, covering three proficiency levels—beginner, intermediate, and advanced—and includes both class-based and function-based problem types with detailed problem specifications and comprehensive test suites achieving 99.1% coverage. To facilitate widespread adoption, we developed RunCodeEval, an open-source execution framework that provides researchers with a ready-to-use evaluation pipeline. Our evaluation of 15 state-of-the-art LLMs revealed consistent performance degradation with increasing complexity (validated statistically, Cohen’s d = 0.790) and universal struggles with advanced concepts like concurrency. Code quality is inherently subjective, encompassing dimensions like readability, efficiency, and adherence to language idioms that traditional static metrics fail to capture adequately. While large language models can assess these subjective qualities, lightweight models offer practical advantages: seamless CI/CD pipeline integration, lower operational costs, and full control over model behavior. We investigate whether such models can learn to assess code quality by training on synthetic LLM annotations. We introduce CodeQual, a dataset of 5,819 code samples derived from five established sources spanning diverse domains—competitive programming, pedagogical problems, software engineering, and general benchmarks—scored by LLMs across five quality dimensions, with 655 human-annotated samples for evaluation. Our fine-tuned model, CodeQualBERT, not only matches LLM performance but exceeds inter-human agreement on all five dimensions, achieving 16–100% improvement over the inter-human agreement baseline. Together, these contributions provide a comprehensive framework for evaluating and improving LLMs in software engineering contexts, encompassing both functional correctness assessment and subjective code quality evaluation.},
}

