@article{le2026get,
  title = {Get Hint-Augmented GRPO Done Right Through Activation Steering},
  author = {Khiem Le and Ting Hua and Nitesh V. Chawla},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2611.23124},
  url = {https://doi.org/10.48550/arxiv.2611.23124},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {activation steering, LLM reasoning, steering vectors, mathematical problem solving, training-inference gap},
  abstract = {GRPO has become the dominant reinforcement learning method for eliciting reasoning capability in LLMs using verifiable rewards. However, it suffers from a fundamental failure mode: when a training question exceeds the base model's current capability, all generated responses fail and receive zero reward, yielding no gradient signal and stalling further capability expansion. An emerging class of GRPO extensions, termed Hint-Augmented GRPO (HA-GRPO), adds a "hint" to the context to reduce the difficulty of the question, thereby producing a usable gradient signal. Nevertheless, existing HA-GRPO methods share a key issue: no hint is available at inference time to append to the question, creating a training-inference context mismatch that leads to inconsistent performance gains. In this work, we reinterpret the function of hinting -- not as reducing question difficulty, but as steering model behavior -- and propose ASH (Activation Steering for Hinting), a novel HA-GRPO method built on this view. During training, the model is presented with both hinted and plain questions, while a trainable steering vector is optimized to widen the margins between the model's generation probabilities for responses to the hinted version relative to the plain version, thereby capturing the question-agnostic component of the behavioral shift induced by the hint. During inference, the trained steering vector is directly injected into the model's activation, reproducing the hint-conditioned behavior without requiring any hint in the context. Experiments with four LLMs (Qwen3-1.7B/4B-Base, Llama-3.2-1B/3B-Instruct) show that ASH consistently improves pass@$k$ on competition-level mathematics benchmarks (AMC, OlympiadBench, AIME24, AIME25) and out-of-distribution benchmarks (Minerva, GPQA-Diamond). Notably, it improves average pass@8 of Qwen3-1.7B-Base and Qwen3-4B-Base by \textbf(2.60)\% and \textbf(2.21)\%.},
}

@article{kaariainen2026hallusinaatioiden,
  title = {Hallusinaatioiden havaitseminen tekoälyllä tuotetussa tietotekniikan koulutusmateriaalissa},
  author = {Aleksi Kääriäinen},
  journal = {Aaltodoc (Aalto University)},
  year = {2026},
  url = {https://aaltodoc.aalto.fi/handle/123456789/147297},
  publisher = {Aalto University},
  keywords = {hallucination detection, large language models, in-context learning, computer science education, model size effects},
  abstract = {A limitation of Large Language Models (LLMs) is their tendency to hallucinate, where their output is contradictory with either established world knowledge or context provided in the prompt. The hallucination rate has been previously shown to reduce with the use of In-Context Learning (ICL). ICL is an ability of LLMs to learn new tasks from a few in-context demonstrations. This thesis focuses on detecting faithfulness hallucinations in AI-generated Computer Science education material. In this thesis, a faithfulness hallucination detection pipeline is developed and evaluated with a number of LLMs and various ICL configurations using an existing dataset consisting of AI-generated programming exercises, which is further altered to incorporate a larger number of faithfulness hallucinations. The evaluation compares the ICL configurations with baselines obtained by using the model in a regular, 0-shot prompting setting. The baseline performance of the models are reasonably good, where larger models perform better than smaller models. The results show that with the use of ICL, the evaluated models sometimes improve their performance over the baselines. Furthermore, it is seen that smaller models benefit from ICL disproportionally, experiencing larger performance gains than larger models. The developed pipeline is not able to completely eliminate the performance gap between larger and smaller models, but it is nearly halved. Furthermore, of the small models, Llama-8B obtains performance scores almost as good as the top performer with the use of ICL. The results suggest that with careful configuration, In-Context Learning can be used to improve the performance of Large Language Models in detecting faithfulness hallucinations in AI-generated programming exercises.},
}

@article{yang2026how,
  title = {How Much Can Language Models Gain from Test-Time Computation?},
  author = {Bangji Yang and Jingyuan Li and Jiajun Fan and Yi Evie Zhang and Ruihan Guo and MA Hongba and Neil He and Chumeng Liang and Qinglong Zheng and Zhanghan Ni and Ge Liu},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2610.01110},
  url = {https://doi.org/10.48550/arxiv.2610.01110},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {model selection, self-revision, competitive programming, mathematics competitions, agentic workflows, Claude Opus, reasoning models},
  abstract = {How much can test-time computation improve a language model, and at what cost? Test-time scaling is widely proposed as a substitute for larger models, but existing comparisons mostly evaluate one domain at a time and rarely charge selection to the budget. We introduce SELF-POT, a benchmark and evaluation framework that measures the test-time potential of a model across competition mathematics, competitive programming, and agentic workflows. SELF-POT separates candidate coverage from final accuracy on static tasks, tracks correctness transitions under revision, and measures protocol completion alongside task success in agentic environments. Under a unified budget rule, it compares Direct inference with parallel sampling and self-revision under fixed multiples of the Direct budget, and charges every model call, including selection and critique, in dollars. This design supports two kinds of comparison: the gain a model obtains from additional inference, and a lower-cost model with additional inference against a stronger model. Across five low-cost reasoning models on 350 sealed tasks, with Claude Opus 5.5 Direct as the reference, the returns depend on the domain, the selection rule, and failure handling. When we replay the retained programming candidate pools, public-example selection raises correct submissions from 376 to 453 of 500 scheduled cells while saving 12-49% of logical API cost across models, and simply retaining an available candidate when judging fails recovers 61 submissions at unchanged cost. On identical mathematics pools, judging with fallback yields 186 correct submissions versus 182 for voting, while voting saves 12-21% of logical API cost. These controlled replays show how selection and failure handling change the gains realized from the same generated candidates, and they quantify the marginal value of a model judge.},
}

@article{wang2026how,
  title = {How Well Do Large Language Models Solve Advanced Programming Contest Problems?},
  author = {Zhexu Wang and Weiran Xu},
  year = {2026},
  pages = {110--117},
  doi = {10.1109/aice71085.2026.11736989},
  url = {https://doi.org/10.1109/aice71085.2026.11736989},
  keywords = {large language models, competitive programming, code reasoning, benchmark, ICPC, LLM evaluation},
  abstract = {Recent advancements in large language models (LLMs) have demonstrated remarkable progress in mathematical and coding reasoning. However, existing code benchmarks remain limited in their ability to evaluate advanced code reasoning on top-tier human programming competition tasks. To address this specific gap, we introduce ContestEval, a novel and challenging benchmark designed specifically to assess LLM reasoning in competitive programming. ContestEval comprises 232 programming competition problems from NOI and ICPC, providing a rigorous test of models’ reasoning skills. We conducted a comprehensive evaluation of 37 models on ContestEval, including a mix of closed-source, open-source, reasoning-oriented, and general-purpose models. Our results indicate that even state-of-the-art reasoning models like o4-mini and Gemini-2.5-pro-exp struggle with challenging, competition-level problems, highlighting the significant challenges models face in this domain.},
}

@article{hadhoud2026ideab,
  title = {Idea First, Code Later: Disentangling Problem Solving from Code Generation in Evaluating and Improving LLMs for Competitive Programming},
  author = {Sama Hadhoud},
  year = {2026},
  doi = {10.82419/424},
  url = {https://doi.org/10.82419/424},
  keywords = {competitive programming, large language models, problem solving, code generation, LLM evaluation, algorithmic reasoning, multi-agent pipeline, prompt optimization, evolutionary search, curriculum learning, LLM-as-a-judge, benchmarking},
  abstract = {Large Language Models (LLMs) increasingly succeed on competitive programming problems, yet existing evaluations conflate algorithmic reasoning with code-level implementation. We argue that competitive programming is fundamentally a problem-solving task and propose centering natural-language editorials in both solution generation and evaluation. Generating an editorial prior to code improves solve rates for some LLMs, with substantially larger gains when using expertly written gold editorials. However, even with gold editorials, models continue to struggle with implementation, while the gap between generated and gold editorials reveals a persistent problem-solving bottleneck in specifying correct and complete algorithms. Beyond pass/fail metrics, we diagnose reasoning errors by comparing model-generated editorials to gold standards using expert annotations and validate an LLM-as-a-judge protocol for scalable evaluation. We introduce a dataset of 83 ICPC-style problems with gold editorials and test suites, and evaluate 19 LLMs, arguing that future benchmarks should explicitly separate problem solving from implementation. To address the implementation gap, we decompose editorial-to-code generation into a multi-agent pipeline with specialized planning, critique, implementation, and debugging agents. We show that prompt optimisation via an evolutionary, blame-guided search with a difficulty-bucketed curriculum raises a 20B-parameter model's pass@1 from 47.0\% to 59.0\%, matching much larger frontier models. These results demonstrate that pipeline design and prompt optimisation are underexplored dimensions of model capability in competitive programming.},
}

@article{gharibi2026illusions,
  title = {Illusions for Machines Benchmark Dataset: Adversarial Attacks on OCR via Human Visual Patterns Benchmark Dataset},
  author = {Dwin Gharibi},
  journal = {Figshare},
  year = {2026},
  doi = {10.6084/m9.figshare.32779587},
  url = {https://doi.org/10.6084/m9.figshare.32779587},
  publisher = {Figshare (United Kingdom)},
  keywords = {optical character recognition, AI-assisted cheating, examination integrity, human readability, Gestalt principles, perceptual organization, multimodal large language models, vision-language models, automated assessment systems, programming competition, perceptual similarity},
  abstract = {This work introduces Illusions for Machines, a perception-driven framework designed to enhance integrity in AI-assisted environments such as online examinations, programming contests, and automated assessment systems. The motivation of this study is the increasing reliance on general-purpose AI systems, including Optical Character Recognition (OCR), large language models (LLMs), multimodal LLMs, and vision-language models (VLMs), which can be used to extract and interpret information from images of exam or contest content. In such settings, users may capture screenshots or photographs of ques- tions and submit them to external AI systems for automated solving. To address this emerging integrity risk, we investigate perception-based trans- formations that preserve human readability while reducing the effectiveness of machine interpretation across OCR pipelines, vision encoders, LLM-based reasoning systems, and multimodal agents operating on extracted text. What is proposed in this work • We propose a perception-driven transformation framework aimed at preserving human readability while limiting machine interpretability in AI-assisted environments. • We introduce a unified, architecture-agnostic evaluation framework applicable to OCR systems, LLM pipelines, and multimodal LLMs that process visual or extracted textual inputs. • We design a composite evaluation metric that jointly measures machine interpretability degradation, human readability preservation, and perceptual similarity. • We construct a large-scale benchmark consisting of 27 transformation families evaluated over 213,840 samples. • The benchmark follows a controlled experimental grid defined by: – 20 reference text samples – 11 font families – 9 font sizes – 4 transformation intensity levels – 27 transformation types Novel contributions • We formalize a general class of perception-based transformations for integrity preservation against AI-assisted information extraction. • We demonstrate that machine systems, including OCR engines, LLM-based pipelines, and multimodal LLMs, remain sensitive to structural and gestalt-based perturbations. • We provide empirical evidence of a persistent gap between human visual cognition and machine interpretation across multiple AI modalities. • We establish a reproducible benchmarking protocol for evaluating robustness against AI-assisted cheating via image capture and external model querying. Key findings Limited robustness of general-purpose AI systems • OCR systems, vision-language models, and multimodal LLM pipelines all exhibit sensitivity to structurally transformed text inputs. • Downstream LLM reasoning over extracted or vision-encoded text is affected by upstream perceptual degradation. Effectiveness of perception-driven transformations • Transformations inspired by human perceptual organization (e.g., Gestalt principles) significantly reduce machine interpretability. • Human readers remain able to reconstruct semantic content through cognitive pattern completion mechanisms. Dominant mechanism of degradation • Disruption of layout consistency, character connectivity, and structural alignment is more effective than pixel-level perturbations. • Machine systems rely on brittle intermediate representations that can be selectively destabilized. Preservation of human readability • Across most transformation settings, human readability remains high while machine interpretability significantly decreases. • This indicates a separable design space between human and machine perception. Final takeaway • AI-assisted cheating in exams and programming contests increasingly relies on general-purpose AI systems, including OCR engines, LLMs, and multimodal models. • Conventional pixel-level obfuscation is insufficient against these systems. • Perception-driven transformations provide a general mechanism to reduce machine interpretability while preserving human readability. • The proposed framework highlights a broader direction for integrity preserving design in AI-mediated information environments.},
}

