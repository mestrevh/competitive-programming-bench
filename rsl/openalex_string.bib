@article{gharibi2026illusionsb,
  title = {"Illusions for Machines Dataset: Adversarial Attacks on OCR via Human Visual Patterns Dataset"},
  author = {Dwin Gharibi and Mohammad Amin Haji Alirezae and Kaebeh Yaeghoob},
  journal = {IEEE DataPort},
  year = {2026},
  doi = {10.21227/kpc2-7x60},
  url = {https://doi.org/10.21227/kpc2-7x60},
  keywords = {adversarial attacks, optical character recognition, human readability, AI-assisted cheating, programming competition, multimodal large language models, vision-language models},
  abstract = {"This work introduces Illusions for Machines, a perception-driven frameworkdesigned to enhance integrity in AI-assisted environments such as onlineexaminations, programming contests, and automated assessment systems.The motivation of this study is the increasing reliance on general-purposeAI systems, including Optical Character Recognition (OCR), large languagemodels (LLMs), multimodal LLMs, and vision-language models (VLMs),which can be used to extract and interpret information from images of examor contest content.In such settings, users may capture screenshots or photographs of ques-tions and submit them to external AI systems for automated solving. Toaddress this emerging integrity risk, we investigate perception-based trans-formations that preserve human readability while reducing the effectivenessof machine interpretation across OCR pipelines, vision encoders, LLM-basedreasoning systems, and multimodal agents operating on extracted text.What is proposed in this work\u2022 We propose a perception-driven transformation framework aimed at preserving human readability while limiting machine interpretability in AI-assisted environments.\u2022 We introduce a unified, architecture-agnostic evaluation framework applicable to OCR systems, LLM pipelines, and multimodal LLMs that process visual or extracted textual inputs.\u2022 We design a composite evaluation metric that jointly measures machine interpretability degradation, human readability preservation, and perceptual similarity.\u2022 We construct a large-scale benchmark consisting of 27 transformation families evaluated over 213,840 samples.\u2022 The benchmark follows a controlled experimental grid defined by:\u2013 20 reference text samples\u2013 11 font families\u2013 9 font sizes\u2013 4 transformation intensity levels\u2013 27 transformation typesNovel contributions\u2022 We formalize a general class of perception-based transformations for integrity preservation against AI-assisted information extraction.\u2022 We demonstrate that machine systems, including OCR engines, LLM-based pipelines, and multimodal LLMs, remain sensitive to structural and gestalt-based perturbations.\u2022 We provide empirical evidence of a persistent gap between human visual cognition and machine interpretation across multiple AI modalities.\u2022 We establish a reproducible benchmarking protocol for evaluating robustness against AI-assisted cheating via image capture and external model querying. Key findingsLimited robustness of general-purpose AI systems\u2022 OCR systems, vision-language models, and multimodal LLM pipelines all exhibit sensitivity to structurally transformed text inputs.\u2022 Downstream LLM reasoning over extracted or vision-encoded text is affected by upstream perceptual degradation.Effectiveness of perception-driven transformations\u2022 Transformations inspired by human perceptual organization (e.g., Gestalt principles) significantly reduce machine interpretability.\u2022 Human readers remain able to reconstruct semantic content through cognitive pattern completion mechanisms.Dominant mechanism of degradation\u2022 Disruption of layout consistency, character connectivity, and structural alignment is more effective than pixel-level perturbations.\u2022 Machine systems rely on brittle intermediate representations that can be selectively destabilized.Preservation of human readability\u2022 Across most transformation settings, human readability remains high while machine interpretability significantly decreases.\u2022 This indicates a separable design space between human and machine perception.Final takeaway\u2022 AI-assisted cheating in exams and programming contests increasingly relies on general-purpose AI systems, including OCR engines, LLMs, and multimodal models.\u2022 Conventional pixel-level obfuscation is insufficient against these systems.\u2022 Perception-driven transformations provide a general mechanism to reduce machine interpretability while preserving human readability.\u2022 The proposed framework highlights a broader direction for integrity preserving design in AI-mediated information environments."},
}

@article{mahendrakar2026hard,
  title = {A Hard-Task Gain Is Not a Change of Shape: When Language-Model Progress Is One Number, Why a Difficulty-Specific Gain Is Defined Only Relative to a Scale, a Difficulty Coordinate, an Overlap in Ability and a System Boundary, and What a Claim of Non-Scalar Progress Has to Carry},
  author = {Pranay M. Mahendrakar},
  journal = {Zenodo (CERN European Organization for Nuclear Research)},
  year = {2026},
  doi = {10.5281/zenodo.23981036},
  url = {https://doi.org/10.5281/zenodo.23981036},
  publisher = {European Organization for Nuclear Research},
  keywords = {benchmark scores, task difficulty, Rasch model, competitive programming, rank reversal, system boundaries, reasoning models},
  abstract = {(c) 2026 Pranay Mahendrakar. Licensed under CC BY 4.0. Life of Research Progress in language models is usually reported as one number: a time horizon, a latent ability on a stitched scale, or an average benchmark score. Whether one number is enough is now disputed. Cross-sectional analyses find that three principal components explain about 97 percent of the variance in a model-by-benchmark matrix and that a single stitched capability predicts most benchmark scores well, and a July 2026 study shows that a one-dimensional Rasch model with rising ability reproduces the apparent migration of gains toward harder agentic tasks. The same study then reports a residual gain on the hardest competitive-programming problems of about +0.40 logits that the scalar model does not absorb, while other work documents crossovers, rank reversals and capability dimensions that progress at different rates. In this analysis the author reviews and synthesises published results to show that most of this disagreement is about the reference against which "shape" is measured, not about the models. A difficulty-specific gain is defined only relative to four choices: the response scale, because an interaction that keeps its sign can be removed by a monotone rescaling and only a crossover cannot; the difficulty coordinate, because difficulty estimated from the models being compared manufactures patterns that exogenous labels do not; the range in which the groups overlap in ability, outside which a functional form rather than the data carries the claim; and the system boundary, because scaffolds, inference budgets and model eras move together. Read against these four, the published record supports a narrower statement than either side makes: progress is close to scalar within one population, scale and boundary; the best-identified hard-item residual is real, scale-relative, and identified without a functional form only in the lower-ability range where pre- and post-era models overlap; and the clearest non-removable departures from one number appear across skill dimensions and between system configurations, including one crossover along puzzle complexity between reasoning and non-reasoning models at matched compute, rather than in era-on-era comparisons of deployed models along difficulty. The paper consolidates 41 published results in a table and a figure, states a decision procedure for reading a claim of non-scalar progress, and specifies six measurements that would settle the open part.},
}

@article{srivibhav2026localization,
  title = {A Localization Framework for Reasoning Faults in LLM-based Code Agents},
  author = {Birudugadda Srivibhav and Sriman Reddy Kondam and Nakka Naga Bhuvith and Koleti Eswar and Shouvick Mondal},
  journal = {Zenodo (CERN European Organization for Nuclear Research)},
  year = {2026},
  doi = {10.5281/zenodo.18225440},
  url = {https://doi.org/10.5281/zenodo.18225440},
  publisher = {European Organization for Nuclear Research},
  keywords = {reasoning failure, failure localization, competitive programming, GPT-4o},
  abstract = {Autonomous LLM-based code agents are rapidly advancing, yet their practical utility is hindered by a critical gap in our under- standing of their failures. When an agent fails, the root cause is often not a simple code bug but a complex flaw in its internal rea- soning process, which is captured in unstructured "hypothesis" logs. To date, there has been no annotated dataset to systemati- cally study this phenomenon, especially on complex, competitive programming-style tasks. To address this gap, we introduce APPS- Failure-DB, a new benchmark dataset of 2450 unique, validated reasoning failures from an LLM agent (Qwen 7B Coder) tasked with solving problems from the APPS dataset. We generated this dataset using a novel "Oracle-Annotated Pipeline," where a blind Oracle Agent (GPT-4o) validates and provides ground-truth anno- tations for each logical failure. Building on this dataset, we propose and evaluate a new, tool-assisted localization framework that is the first to link the unstructured text of an agent’s hypothesis log to specific code-level faults. Our framework combines dynamic analysis (coverage tracing) with a semantic "Tracer Agent" to build a traceability map, enabling a final "Debugger Agent" to perform precise localization. Our results demonstrate that we can charac- terize failure patterns in agent reasoning, with 73.82% of failures occurring in the Execution-Phase, and achieve a reasoning-phase localization accuracy of 67.48%. While code-line-level localization remains challenging with our 7B parameter model (F1-Score of 0.0714), our framework establishes a foundation for future work with larger models. This work contributes both a new dataset for the research community and a novel framework for diagnosing agent reasoning failures.},
}

@article{yip2026multi,
  title = {A multi-agent system for automated identification of competitive clinical trials in colorectal cancer.},
  author = {Stephen S. Yip and Jitesh Chawla and Michael Rossi and Sheenu Chandwani and Pyeush Gurha},
  journal = {Journal of Clinical Oncology},
  year = {2026},
  volume = {44},
  pages = {193},
  doi = {10.1200/jco.2026.44.2_suppl.193},
  url = {https://doi.org/10.1200/jco.2026.44.2_suppl.193},
  publisher = {Lippincott Williams & Wilkins},
  issn = {0732-183X},
  keywords = {colorectal cancer, multi-agent systems, AI agents, trial planning, inclusion and exclusion criteria, text embeddings, semantic similarity, ClinicalTrials.gov, HER2-positive colorectal cancer, MSI-H/dMMR, trial design, patient recruitment, site selection},
  abstract = {193 Background: Understanding the competitive clinical trial landscape is essential for successful trial planning, particularly in colorectal cancer (CRC) where diverse genetic subtypes (HER2+, MSI-H/dMMR) create a complex treatment environment. Traditional manual review of competing trials is time-consuming and may miss important competitive factors. We developed an automated system using AI agents to identify and analyze competing trials, helping clinicians and trial designers make informed decisions about trial design, patient recruitment, and site selection. Methods: This study analyzed over 500,000 registered trials from ClinicalTrials.gov, focused on assessing the intelligence of 11 major CRC trials from leading sponsors. Our AI system evaluates trial competition across four key dimensions: how similar the trials are overall, overlap in patient eligibility criteria, similarity of clinical endpoints, and whether trials are recruiting during the same timeframe. The system uses three specialized AI agents working in sequence: a Screener that identifies potentially relevant trials, a Matcher that performs detailed comparisons, and a Ranker that generates final competitiveness scores. The technology converts trial text into numerical representations (called embedding) that allow precise similarity measurements between different trials, using OpenAI’s text-embedding-large model and Claude-4-Sonnet LLM for semantic understanding. Results: The system successfully distinguished between truly competing and non-competing trials. For example, trials targeting opposite patient populations (MSI-H/dMMR versus MSS/pMMR) received low cosine similarity scores of 0.1, correctly identifying them as distinct. Conversely, trials with similar HER2+ eligibility criteria, despite different wording, received high similarity scores of 0.71, flagging them as potentially competitive. When analyzing the most similar trials, the system achieved high accuracy with average similarity scores of 0.78 for trial summaries and 0.71 for eligibility criteria. As expected, expanding the analysis to include more trials (from 5 to 50) included less relevant studies, with scores appropriately decreasing to reflect lower competition levels. Conclusions: Our AI-powered system provides clinicians and trial teams with a valuable tool to quickly and efficiently analyze competitive trials. Its scalability and indication-agnostic design enable broad application across therapeutic areas for competitive intelligence and strategic trial planning.},
}

@article{wakatani2026prototype,
  title = {A PROTOTYPE SYSTEM FOR LLM-BASED AUTOMATIC GENERATION OF MULTIPLE-CHOICE QUESTIONS IN MACHINE LEARNING PROGRAMMING},
  author = {A Wakatani and T Maeda},
  year = {2026},
  pages = {123--132},
  doi = {10.17501/24246700.2026.12108},
  url = {https://doi.org/10.17501/24246700.2026.12108},
  keywords = {large language models, automatic question generation, multiple-choice questions, programming education, scikit-learn, prompt engineering, programming exercises},
  abstract = {In recent years, the importance of mathematical, data science, and AI education has grown significantly, making it necessary to learn machine learning programming. In programming education, while acquiring knowledge through lectures is important, the experience of actually creating programs helps solidify that knowledge. However, preparing numerous programming assignments places a significant burden on educators. This study proposes a system that utilizes large language models (LLMs) to generate programming tasks for scikit-learn, a machine learning library written in Python. It describes the implementation and evaluation of a prototype version of this system. The programming exercises used in that system implement a multiple-choice question format where part of the program is left blank, and the student must fill in the missing text. This serves as an alternative implementation for programming exercises. Our preliminary evaluation confirmed that by refining the prompt, tasks suitable for the purpose are automatically generated. However, to achieve accurate task generation, additional instructions to the prompt are required for each target problem category. Therefore, establishing a universal prompt generation method for this purpose is a future challenge},
}

@article{bass2026validation,
  title = {A Validation and Governance Framework for Multi-Agent LLM Scientific Software Development},
  author = {T. Bass},
  journal = {Zenodo (CERN European Organization for Nuclear Research)},
  year = {2026},
  doi = {10.5281/zenodo.19466730},
  url = {https://doi.org/10.5281/zenodo.19466730},
  publisher = {European Organization for Nuclear Research},
  keywords = {large language models, LLM-based code generation, multi-agent systems, quantum mechanics, code validation, scientific software development, Claude, codices, hallucinations, prompt engineering, software governance, ruby, non-deterministic systems},
  abstract = {Large language models are non-deterministic systems whose outputs vary across runs, model versions, and context configurations. Existing benchmarks for LLM code generation evaluate correctness against synthetic test suites or competitive programming problems, not against peer-reviewed scientific data. This paper presents quantum_bench, a controlled multi-agent experiment in which generated code is validated against analytical values from Griffiths and Schroeter (2018), a standard graduate-level quantum mechanics reference. The experiment implements exact analytical solutions to five Tier 2 applied quantum mechanics problems in pure Ruby, using a two-agent LLM architecture: Claude as architect (prompt designer) and Codex as coder (Ruby implementer), with a human principal investigator as the non-delegable evaluator at each of 13 development gates. The primary finding is not about quantum mechanics. It is about the multi-agent workflow itself: Claude, acting as architect, repeatedly hallucinated experiment goals that were never stated, substituted its own interpretations despite explicit correction, and directed Codex down architecturally wrong paths. Codex performed correctly throughout, implementing what each prompt specified. In this Claude-as-architect, Codex-as-coder configuration, the architect role was the dominant source of failures, not the coder role. Claude errors are documented in five groups ordered by severity: goal substitution, incomplete refactors, context loss, prompt design gaps, and process violations, totaling 21 architect-level errors across 13 gates against zero architectural errors from Codex. All five quantum mechanics problems ultimately pass validation against Griffiths and Schroeter values. Governance and control methods based on experimental lessons learned are also summarized.},
}

@article{meng2026adakp,
  title = {AdaKP: Online Adaptive Knowledge-Point Selection for Reasoning-Oriented Reinforcement Learning},
  author = {Zibin Meng and Zhenyu Zhao and Chunqiang Run},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2607.24833},
  url = {https://doi.org/10.48550/arxiv.2607.24833},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {online selection, verifiable rewards, reward sparsity, large language models, mathematical reasoning, adaptive scheduling, DAPO, Group Relative Policy Optimization},
  abstract = {Reinforcement learning with verifiable rewards is a powerful paradigm for eliciting reasoning in large language models, yet it suffers from severe reward sparsity on competition-level mathematics. A common remedy injects atomic knowledge points (KPs) - short natural-language hints distilled from gold solutions - into the prompt. Existing methods, however, either fix this selection once offline or merely scale the monolithic quantity of injected text, leaving untouched the most informative axis of choice: which subset of atomic KPs to inject, and when. We introduce AdaKP, an online selector that re-chooses each problem's KP subset over the course of RL training. At its core is an entropy proxy that scores a KP by the reduction in next-token entropy it induces - a single inexpensive forward pass, with a provable bound on its truncation bias - in place of expensive rollout-based estimation. Three lightweight mechanisms make this signal usable online: a momentum smoother that absorbs per-step noise, a retirement-and-revival manager that prunes weak KPs while preserving exploration, and an adaptive scheduler that front-loads re-evaluations into early training. AdaKP further contributes a pre-flight validation gate that certifies the proxy against a leave-one-out ground truth before any expensive run is launched, turning method-level risk into a falsifiable check. Realized as a fully additive fork of a standard DAPO+GRPO trainer with no optimizer changes, AdaKP improves over a strong static-selection baseline on all eight competition-mathematics benchmarks at negligible added cost, positioning online, validated KP-subset selection as a practical and as-yet under-explored axis for reasoning-oriented reinforcement learning.},
}

@article{li2026agar,
  title = {AGAR: a reinforcement learning substrate for LLM program evolution},
  author = {Haoran Li and Zengle Ge and Xiaomin Yuan and Yui Lo and Haoxin Li and Songlin Zhou and Qianhui Liu and Jiahua Ying and Yuanhang Liu and Mingju Chen and Annan Li and Jianmin Wu and Dawei Yin and Dou Shen},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2610.09215},
  url = {https://doi.org/10.48550/arxiv.2610.09215},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {algorithm discovery, software evolution, large language models, reinforcement learning, Markov decision process, credit assignment, value estimation, adaptive exploration, experience memory, competitive programming, transfer learning},
  abstract = {Given a task and an evaluator, a language model can rewrite a candidate program while a search loop decides which rewrites survive, offering a practical route to algorithm discovery. But that loop is governed by five constants set by hand: which parent to select, how hard to mutate, how to keep diversity, what to remember, and a scalar score that never says which part of the program earned it. Reinforcement learning already has an estimator for each. The obstacle is that program evolution is not usually written down as a decision process. We formalize it as a Markov decision process whose action is the modular prefix the model is conditioned on, rather than the program it emits. Credit assignment, value estimation, adaptive exploration, and experience memory can then attach to distinct components. AGAR (Algorithm Generation As RL) provides the resulting substrate: any estimator can be replaced or switched off without changing the controller, making the transfer auditable one mechanism at a time, with no gradient training of the backend model. Across 19 tasks, two backends, and three seeds under one harness, AGAR improves on the stronger of two published baselines on most tasks, with gains concentrated in the competitive-programming family. The formalization also yields a checkable reading of prior work: these systems are implicitly zero-discount, not by choice, but because fitness is exogenous to an individual rather than a return over successors, leaving a discount factor nothing to act on.},
}

@article{terekhov2026control,
  title = {AI Control for Language Model Agents},
  author = {Mikhail V. Terekhov},
  journal = {Infoscience (Ecole Polytechnique Fédérale de Lausanne)},
  year = {2026},
  doi = {10.5075/epfl-thesis-12434},
  url = {https://doi.org/10.5075/epfl-thesis-12434},
  publisher = {École Polytechnique Fédérale de Lausanne},
  keywords = {artificial intelligence control, language model agents, AI alignment, prompt injection, red teaming, training program, backdoor detection},
  abstract = {AI control is a field of study intended to provide a second layer of defense should our efforts at AI alignment fail. Starting with the premise that an AI system is misaligned, AI control is concerned with designing mechanisms to either prevent misbehavior or catch the AI red-handed. In this thesis, we present an overview of AI control alongside several contributions to the field, split into the following chapters: Overview of AI control. To motivate AI control, we begin with a survey of theoretical and empirical evidence of misalignment in modern AI systems. Then, we discuss the high-level principles that guide AI control mitigations, covering common deployment contexts, the specific threats that AI control aims to prevent, and how AI control evaluations are conducted. We also introduce a distinction between concentrated and diffuse threats from untrusted AI models and discuss why these two types of threats demand different mitigations. Concentrated threats are those that unfold over a short period of time. The science of concentrated threats, sometimes called concentrated AI control, is more developed; following prior work, we present a mathematical model that can be used to evaluate the safety of concentrated AI control protocols. Control tax. In this chapter, we study a concentrated AI control protocol called trusted monitoring. Trusted monitoring proceeds by having a weaker trusted AI model assign suspiciousness scores to the actions of the untrusted model, with the most suspicious actions escalated for human auditing. To evaluate trusted monitoring, we have language models generate solutions to competitive programming problems that contain subtle bugs. We then test how well other models can distinguish these "backdoored" solutions from the correct ones. Using the mathematical model from the previous chapter, we show how to compute the safety of trusted monitoring analytically in the limit of a large number of deployed AI agents. Finally, we combine our applied and theoretical results under the framework of the control tax---the operational and financial cost of integrating trusted monitoring into AI pipelines. Adaptive attacks on AI control protocols. In this chapter, we present simple attacks that subvert existing monitoring-based protocols in concentrated AI control. The most common kind of trusted monitor used in control protocols is a prompted language model, and language models are notoriously susceptible to prompt injections. We exploit this vulnerability to demonstrate that trusted monitors can be induced to label most of the code they see as not suspicious, rendering them essentially useless. Our language model-generated prompt injections generalize across several monitors. Using the mathematical model from the previous chapters, we show the disastrous downstream effects of these prompt injections on the safety of multiple control protocols. Diffuse AI control on fuzzy tasks. In this chapter, we propose a red-teaming framework for evaluating training interventions against diffuse threats from a misaligned AI, such as deliberately underperforming on difficult-to-grade tasks. We show that a misaligned AI can subvert the process of generating ML experiment ideas even when optimized against scores assigned by a weaker model. We also show that there exist prompts for the weak scorer that significantly improve its robustness, though efficiently discovering such prompts with realistic affordances remains an open problem.},
}

@article{k2026powered,
  title = {AI-Powered Mock Interview Platform for Personalized Multimodal Interview Preparation and Performance Evaluation},
  author = {Sitheswar K and Siva M and R. Vinoth Kumar},
  journal = {Research Square},
  year = {2026},
  doi = {10.21203/rs.3.rs-11485890/v1},
  url = {https://doi.org/10.21203/rs.3.rs-11485890/v1},
  keywords = {campus placement, facial landmark tracking, iris tracking, speech transcription, speech synthesis, biometric privacy, applicant tracking systems, LLM-based reasoning},
  abstract = {Modern campus placement and technical recruitment pipelines demand a multilayer evaluation of graduating software engineers, encompassing algorithmic problem-solving proficiency, structured verbal reasoning, and composed nonverbal delivery. However, scalable mock interview preparation remains constrained by human-resource-intensive faculty panels and the summative, non-pedagogical design of commercial video screening software. This paper presents an integrated, privacy-preserving multimodal mock interview platform tailored to formative placement training and objective competency evaluation. The decoupled multi-tier architecture combines generative language model reasoning (LLaMA 3.3 70B via Groq Language Processing Unit acceleration), client-side facial and iris landmark telemetry using Google MediaPipe Face Landmarker in WebAssembly, browser-native acoustic speech transcription, neural vocal synthesis via ElevenLabs, and an isolated Wandbox Docker compiler sandbox integrated with a Monaco code editor. Because computer vision inference executes exclusively within volatile client-side browser memory at 5 frames per second (FPS) before immediate frame disposal, the platform requires 0.0 kbps of cloud video streaming bandwidth and preserves candidate biometric privacy with sub-12 ms local tracking latency. A normalized late-fusion assessment algorithm synthesizes verbal semantic depth (55%), vocal cadence and articulation (25%), and visual gaze stability (20%) into auditable multi-tier diagnostic scorecards. Empirical validation across 39 multi-stage simulation sessions (1,367 cumulative practice minutes) achieved 94.2% precision in structured behavioral evaluation, 92.0% steady gaze retention, a 100% test-case pass rate across sandboxed programming challenges, an Applicant Tracking System (ATS) readiness score of 85/100, and an average longitudinal competency gain of +26.4% alongside a reduction in speech disfluencies from 4.2 to 0.2 fillers per minute.},
}

@article{song2026algobench,
  title = {AlgoBench: Benchmarking Algorithmic Adaptation in Code Generation},
  author = {Xinyuan Song and Zekun Cai and L Zhao},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2607.00062},
  url = {https://doi.org/10.48550/arxiv.2607.00062},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {code generation, benchmarking, competitive programming, algorithmic reasoning, algorithmic complexity, LLM evaluation, retrieval-augmented generation, HumanEval, large language models},
  abstract = {High pass rates on established programming benchmarks such as HumanEval and LiveCodeBench do not always show whether a model can reason about algorithms. Many fixed benchmarks eventually become part of the public training ecosystem through released problem statements, editorials, and generated solutions, allowing later models to improve partly by exposure rather than by stronger algorithmic ability. We introduce ALGOBENCH, a framework that automatically builds novel algorithmic problems from known competitive-programming problems through structured constraint-shifting transformations. Each accepted ALGOBENCH variant is traceable to a source problem, but must make the original reference algorithm fail. Beyond pass@$k$, we introduce complexity-aware metrics -- including OPTT, OPTS, TRAPRATE, GAPT, and CONSENS -- to test whether a solution is not only functionally correct but also asymptotically suitable for the generated problem. Experiments across multiple LLMs and prompting strategies show that performance drops sharply on ALGOBENCH variants, retrieval can increase reuse of the old algorithm, and many correct-looking solutions fail to meet the required complexity. Error analysis shows that failures are mainly algorithmic rather than implementation-level, suggesting that ALGOBENCH evaluates adaptation beyond functional correctness.},
}

@article{kaluski2026aloittelijoiden,
  title = {Aloittelijoiden ohjelmointitehtävien kontekstualisointi pienillä kielimalleilla},
  author = {Daniel Kaluski},
  journal = {Aaltodoc (Aalto University)},
  year = {2026},
  url = {https://aaltodoc.aalto.fi/handle/123456789/146031},
  publisher = {Aalto University},
  keywords = {small language models, large language models, contextualization, programming education, model size, model specialization, training data, local deployment, privacy},
  abstract = {This study investigates the ability of small language models (SLMs) to contextualize beginner programming exercises and compares their performance to that of large language models (LLMs). Contextualization can improve engagement and understanding, but solutions based on LLMs raise concerns regarding privacy and computational requirements. SLMs offer full control over input and output data and can be run locally on consumer-grade hardware, making them a potential alternative for such tasks. The objective of this study was to determine whether SLMs can consistently contextualize existing beginner-level programming exercises according to a given context. Models of varying sizes and specializations were evaluated to assess their ability to perform this task and to compare their performance with that of LLMs. The results show that some SLMs are capable of producing meaningful and consistent contextualizations, with performance in certain cases comparable to LLMs. Model size alone was not a reliable predictor of performance, as factors such as training data and model specialization had a significant impact. These findings suggest that appropriately selected SLMs can serve as a viable alternative to LLMs for contextualizing programming exercises.},
}

@article{brindha2026intelligent,
  title = {An Intelligent Framework for Automatic Programming Task Generation from Multimedia Sources},
  author = {D. Brindha and S.D. Kapilan and B.S Vikas and R. Yogesh},
  journal = {International Conference on Computing Theory and Wireless Communications (ICCTWC)},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/icctwc68241.2026.11583145},
  url = {https://doi.org/10.1109/icctwc68241.2026.11583145},
  publisher = {Institute of Electrical and Electronics Engineers},
  keywords = {programming education, multimodal learning, question generation, automated assessment, online learning platforms, personalized learning},
  abstract = {As the use of online learning platforms has increased at a fast pace, so has the demand for effective and adaptive methods of providing students with the best tools possible for acquiring programming knowledge. Video-based tutorials are the primary means of providing programming education. However, they require considerable manual effort to identify key concepts and to build practice tasks, thus creating inefficient learning cycles. In this study, we present a new intelligent framework utilizing both multimodal learning and artificial intelligence (AI), that automatically extracts instructional content from multimedia sources and then produces structured programming exercises from that content. The intelligent framework utilizes an efficient multilayered model that causes the efficient analytical extraction of both visual and linguistic information in educational videos to identify critical learning objectives and contextual problem statements. Additionally, the intelligent framework produces automatic question and answer generation and automated assessment based upon standard validation parameters, thus allowing for programming exercises to be produced for any language. Experimental evaluation shows that this system significantly reduces learner preparation time while maintaining conceptual alignment between instructional content and generated exercises. The current work contributes to a scalable, time-effective, and intelligent pathway toward personalized programming education through automated task generation.},
}

@article{dang2026are,
  title = {Are LLMs Ready for Competitive Programming? An Empirical Study},
  author = {Tran Tri Dang and Jaronie Mohd Jani and Huo-Chong Ling and Linh Duc Tran and Quang Tran and Quy Nguyen and Hoang Tran and Thanh Pham},
  journal = {International Conference on Software and Information Engineering (ICSIE)},
  year = {2026},
  pages = {88--94},
  doi = {10.1145/3789595.3789613},
  url = {https://doi.org/10.1145/3789595.3789613},
  publisher = {Association for Computing Machinery},
  keywords = {large language models, competitive programming, online judge, code generation, algorithmic thinking, self-training, few-shot learning},
  abstract = {Competitive programming (CP) is widely used in computer science education to train algorithmic thinking: solutions must match exact input/output formats, pass both public and hidden tests, and finish within strict time and memory limits. Students can now use large language models (LLMs) to generate sample CP solutions and learn from them by comparing, self-checking, and improving their own code. It is therefore important to understand how well LLMs solve CP problems, especially in university settings where access often comes through privacy-preserving deployments, so their capability for CP training is unclear. This paper reports an empirical study of privately deployed LLMs that generate candidate CP solutions. We measure success by online judge acceptance and analyze results by problem category (e.g., dynamic programming, graphs, greedy) and by two attributes: Popularity (attempts) and Solvability (success rate). We also test a simple few-shot strategy for the better-performing model by adding brief judge feedback after a failed first attempt, for up to four attempts. Results show where these models work well, where they struggle, and how acceptance changes across categories and across Popularity and Solvability ranges. Judge-feedback retries improve acceptance, with the biggest gain after the first retry and smaller gains later. Overall, the study offers practical guidance on when and how privately deployed LLMs can support CP self-training and algorithm practice.},
}

@article{authors2026assembling,
  title = {Assembling Insights for Agentic Machine Learning Engineering Systems},
  author = {Anonymous Authors},
  journal = {Figshare},
  year = {2026},
  doi = {10.6084/m9.figshare.34062453},
  url = {https://doi.org/10.6084/m9.figshare.34062453},
  publisher = {Figshare (United Kingdom)},
  keywords = {data leakage, Kaggle competition, prompt engineering, LLM agents},
  abstract = {Agentic machine learning engineering (MLE) is an emerging AI4SE application, targeting complex machine learning tasks and taking a step toward the recursive self-improvement of AI systems. Recent agentic MLE systems highlight the importance of collecting and leveraging insights from closely-related MLE tasks: some systems condition code generation on expert domain knowledge, which is implicitly curated from peer MLE tasks; some systems have a loop of solving an MLE task, gathering validation feedback, and refining their prompts, skills, or memory to benefit future tasks. However, the process of collecting and injecting insights is ad hoc, and existing evaluations of these systems do not control for the sources of insights, leaving data leakage a threat to validity.To close these gaps, we systematically study how insights assembled from closely-related MLE tasks affect an agentic MLE system, and how their effect depends on the type of insights and the way they are injected. We first collect a new benchmark, MLE-InsightBench, consisting of 160 Kaggle competitions clustered into 12 domains. MLE-InsightBench is designed to keep target task information out of the insights: one competition from each domain is held out as a target task, and only the remaining 148 competitions, none of which can have been influenced by the target tasks (e.g., as a later edition of the same series or by reusing their solutions), serve as source competitions. We then design and implement an insight assembly agent, MLE-InsightForge, that explores the source competitions, their top human-written solutions, and writeups, and assembles them into three types of insights: 12 domain insights (summarizing domain-level best practices), 148 competition insights (describing competition-level winning solutions), and 16 improvement insights (detailing generic debugging and improvement strategies). The extracted insights can be injected into an agentic MLE system as skills, which the agent reads selectively on demand, or as a playbook placed upfront in its initial context. In our evaluation, the extracted insights improve the normalized private-test score of an agentic MLE system by 123.9% over the baseline without insights. Further controlled experiments show that: the three types of insights are complementary, the optimal injection mode (skill vs. playbook) varies across competitions with the skill mode being more cost-effective overall, and the improvements from insights generalize well across different backend LLMs.},
}

@article{baggio2026assessing,
  title = {Assessing the Impact of Retrieval-Augmented Generation on Algorithmic Problem-Solving},
  author = {Gabriel Souza Baggio and Gabriel Machado Lunardi and Guilherme Medeiros Machado and Subhankar Maity and Faiza Belbachir and José Palazzo Moreira de Oliveira},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2611.09791},
  url = {https://doi.org/10.48550/arxiv.2611.09791},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {retrieval-augmented generation, competitive programming, large language models, code generation, algorithmic problem solving, similarity search, embedding-based retrieval, training data memorization, membership inference, knowledge base},
  abstract = {Competitive programming problems pose distinctive challenges for Large Language Models, as they demand not only proficient code generation but also advanced algorithmic reasoning. This study presents a Retrieval-Augmented Generation approach specifically designed to enhance the capacity of Large Language Models to address such problems. Our approach integrates an embedding-based retrieval mechanism and a similarity search algorithm to identify analogous problems within a knowledge database, employing a dynamically adjusted threshold to mitigate retrieval noise. We conducted an evaluation using the CodeContests dataset, focusing on the test split problems that exhibit similarity to instances from the training split. The experimental framework considered three conditions: (i) problems provided solely with their original descriptions, (ii) problems supplemented with randomly selected examples from the training split, and (iii) problems augmented with similar examples retrieved through the proposed method. In addition, we incorporated a Min-K membership inference analysis to examine whether the generated code solutions were influenced by potential memorization of training data within the evaluated Large Language Models. This complementary perspective enables a deeper understanding of model behavior by distinguishing genuine generalization through retrieval from implicit recall of pretraining samples. Performance was assessed using both pass rates and the CodeForces Elo rating of the problems. The results provide empirical evidence that similarity-based retrieval substantially enhances Large Language Models performance in competitive programming scenarios, offering an scalable framework for improving code generation in algorithmic problem-solving contexts.},
}

@article{denny2026assessing,
  title = {Assessing the Quality and Diversity of Student- and AI-Generated Programming Exercises from Limited Examples: Empirical Insights from a Large-Scale Blind Evaluation},
  author = {Paul C. Denny and Juho Leinonen and Arto Hellas and Sami Sarsa and Michael Liut and Hassan Khosravi},
  journal = {Western Canadian Conference on Computing Education},
  year = {2026},
  pages = {1--7},
  doi = {10.1145/3828792.3828801},
  url = {https://doi.org/10.1145/3828792.3828801},
  publisher = {Association for Computing Machinery},
  keywords = {large language models, introductory programming education, personalized learning content, blind evaluation},
  abstract = {As online learning platforms increasingly deliver personalized learning experiences, the demand for high-quality educational content grows. Creating such content presents a growing burden for instructors. Leveraging students for content co-creation (learnersourcing) and the use of large language models (LLMs) are two scalable and promising approaches for addressing this content creation challenge. We compare these approaches in a large introductory programming course (N=950), where students and an LLM independently created ‘code examples’ from the same limited set of exemplars. In a blind evaluation, students rated the correctness and helpfulness of both sets of resources. AI-generated examples were rated comparable in quality to student-generated examples, but more closely resembled the provided exemplars. Student-generated examples showed greater variation in length and syntax. This pattern is consistent with concerns about the homogenizing effects of LLMs. Overall, both learnersourcing and AI-based generation appear viable for producing supplementary programming materials, with indications that LLMs offer more consistency while students contribute greater diversity.},
}

@article{anonymous2026atcoder,
  title = {AtCoder_Regular_APR_Dataset},
  author = {Anonymous},
  journal = {Zenodo (CERN European Organization for Nuclear Research)},
  year = {2026},
  doi = {10.5281/zenodo.20256920},
  url = {https://doi.org/10.5281/zenodo.20256920},
  publisher = {European Organization for Nuclear Research},
  keywords = {automated program repair, competitive programming, bug localization, benchmark dataset, test cases},
  abstract = {This dataset contains buggy and corrected competitive programming programs collected from AtCoder Regular Contest (ARC) for evaluating LLM-based automated program repair (APR) techniques. The dataset includes:- buggy and corrected programs- fault localization variants- diff information- AST-level edit information- test cases and metadata This benchmark is designed to support research on APR effectiveness, bug complexity analysis, fault localization, and LLM-based software engineering tasks.},
}

@article{naseem2026automated,
  title = {Automated Code Generation Using Large Language Models: A Comparative Study},
  author = {Rimsha Naseem and Muhammad Zaki},
  journal = {Research consortium archive.},
  year = {2026},
  url = {https://rcresearcharchive.com/index.php/Journal/article/view/733},
  issn = {3007-0031},
  keywords = {automatic code generation, large language models, codices, CodeGen, CodeLlama, model comparison, HumanEval, MBPP, code efficiency, code safety, algorithmic problem solving, web development, prompt engineering, code readability},
  abstract = {Background: The emergence of large language models (LLMs) has revolutionized automated code generation, which has the potential to increase the productivity of software development. Recent models Codex, AlphaCode, CodeGen and Code Llama have achieved mixed results on coding, but a comprehensive comparison of their effectiveness is not yet available. We attempt to fill that gap by comparing these models under several important aspects of code generation. Objective: This study aims to perform a comprehensive comparative analysis on Codex, AlphaCode, CodeGen, and Code Llama, in terms of their effectiveness in creating valid and efficient code for a variety of tasks involving algorithmic problem-solving, API invocations and web development. Performance The study is also intended to compare the models with several performance metrics, including accuracy, execution success, code efficiency, and safety. Method: The chosen LLMs were experimented on the benchmark datasets (HumanEval, MBPP). Quantitative measures in terms of accuracy, percentage of successfully executed attacks, computational efficiency, and the analysis of discriminative ability were used. Subjective measures (readability, creativity and error types) were also evaluated. A setup of prompt design and model parameters (temperature, etc.) was adjusted for a fair comparison. Results: Across all measures, Codex is found to be the best with the exception of for creative problem solving with AlphaCode performing the best. CodeGen showed a higher efficiency and a lower susceptibility rate. Code Llama came in second place, with lesser performance, but potential for improvement. Conclusion: Overall, Codex tops, but there are specific benefits offered by AlphaCode, CodeGen, and Code Llama for various use-case scenarios. In future research, better security, further optimizing of models for specialized tasks, and removing disadvantages should be the three main parts that researchers can try.},
}

@article{rodil2026buddhai,
  title = {BuddhAi: The Need to Redesign Programming as an Inquiry-Based Education Through the Use of LLM Tutors},
  author = {Kasper Rodil and Ivan Adriyanov Nikolov and Peter Guld Leth},
  journal = {Lecture notes of the Institute for Computer Sciences, Social Informatics and Telecommunications Engineering},
  year = {2026},
  pages = {58--77},
  doi = {10.1007/978-3-032-39734-8_4},
  url = {https://doi.org/10.1007/978-3-032-39734-8_4},
  issn = {1867-8211},
  keywords = {large language models, programming education, inquiry-based learning, Socratic dialogue, solutionism, novice programmers, Llama 3.1, student feedback},
}

@article{santillana2026cabench,
  title = {CABench: Evaluating Constraint-Aware Pragmatism and Algorithmic Over-Engineering in LLM Code Generation},
  author = {Juan S. Santillana},
  journal = {Zenodo (CERN European Organization for Nuclear Research)},
  year = {2026},
  doi = {10.5281/zenodo.24420443},
  url = {https://doi.org/10.5281/zenodo.24420443},
  publisher = {European Organization for Nuclear Research},
  abstract = {Existing code generation benchmarks—including LiveCodeBench, EffiBench, Mercury, and AlgoTune—evaluate functional correctness or asymptotic scalability on large inputs ($N \ge 10^5$), implicitly rewarding heavyweight data structures regardless of problem bounds. When competitive programming (ICPC) constraints are tightly bounded ($N \le 20$), large language models (LLMs) frequently over-engineer solutions with Segment Trees, priority queues, or dynamic programming (DP) tables that suffer from heap allocation and cache overhead rather than emitting pragmatic, cache-friendly brute-force or $O(2^N)$ search. We introduce CABench, a constraint-mutated benchmark of 60 held-out ICPC archetypes across three constraint tiers (Tier S, Tier M, Tier L; 180 evaluation instances) paired with formal metrics: Constraint-Relative Speedup (CRS), Over-Engineering Penalty Index (OEPI), and Pragmatic Efficiency Score (PES). An a priori power analysis shows that $n=60$ paired archetypes per tier halves the minimum detectable effect ($d_z = 0.368$ at 80% power) relative to a 15-archetype pilot ($d_z = 0.778$). Across 8 models spanning closed frontier, open-weight APIs, and local 7B–8B models (1,440 evaluated C++20 programs inside an isolated rootless Podman harness), Claude Haiku 5.5 achieves 100.0% Tier S pass@1 ($\text(PES)=0.733$), GPT-6 Luna reaches 96.7% ($\text(PES)=0.698$), and GLM-5.3-Flash achieves the lowest frontier structural bloat ($\text(OEPI)=0.255$ at Tier S, $0.364$ at Tier L; $p_(\text(Holm)) = 0.0067$ vs. Claude Haiku 5.5). Finally, we show that both zero-shot constraint-aware prompting on Claude Haiku 5.5 ($\text(OEPI)\ 0.359 \to 0.554$, $p = 0.0040$) and 1-epoch QLoRA SFT on Qwen3-8B fail to jointly optimize pragmatism and accuracy (SFT cuts mutually passed OEPI across tiers, $p \le 0.0429$, but degrades Tier M/L pass@1, $p_(\text(Holm)) \le 0.0190$). In contrast, inference-time Best-of-4 PES-guided reranking on GLM-5.3-Flash Tier S simultaneously raises pass rate ($86.7\% \to 98.3\%$, $p = 0.0156$), cuts mutually passed OEPI ($0.255 \to 0.210$, $p = 0.0051$), and achieves $\text(PES) = 0.828$ ($p = 2.04 \times 10^(-7)$).},
}

@article{meng2026can,
  title = {Can a Lightweight Automated AI Pipeline Solve Research-Level Mathematical Problems?},
  author = {Lve Meng and Weilong Zhao and Yanzhi Zhang and Haoxiang Guan and Jiyan He},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2602.13695},
  url = {https://doi.org/10.48550/arxiv.2602.13695},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {large language models, automated proof checking, Gemini 3 Pro},
  abstract = {Large language models (LLMs) have recently achieved remarkable success in generating rigorous mathematical proofs, with "AI for Math" emerging as a vibrant field of research (Ju et al., 2026). While these models have mastered competition-level benchmarks like the International Mathematical Olympiad (Huang et al., 2025; Duan et al., 2025) and show promise in research applications through auto-formalization (Wang et al., 2025), their deployment via lightweight, natural-language pipelines for research problems remains underexplored. In this work, we demonstrate that next-generation models (e.g., Gemini 3 Pro, GPT-5.2 Pro), when integrated into a streamlined automated pipeline optimized for citation-based verification, can solve sophisticated research-grade problems. We evaluate our pipeline on two novel datasets: (1) the ICCM (2025) problem sets (comparable to the S.-T. Yau College Student Mathematics Contest) proposed by leading mathematicians (Shanghai Math Challenge, 2026), and (2) the "First Proof" problem set (Abouzaid et al., 2026), consisting of previously unpublished research questions. Our pipeline generated candidate proofs for all problems in the first two ICCM sets and the "First Proof" set. The solutions for the first two ICCM sets and Problem 4 of the "First Proof" set have been fully verified by our team. All generated proofs have been submitted to the official organization, and our generated results are publicly available at https://github.com/ml1301215/question_sets-test_results. We have open-sourced the code and developed a user-friendly UI for this workflow, accessible at https://github.com/ml1301215/research-math-assistant.},
}

@article{ospanov2026can,
  title = {Can LLMs Reliably Grade Olympiad Proofs? A Study of Mathematical Verification with LLMs},
  author = {Azim Ospanov and Zijin Feng and Ding Ding and Chengwu Liu and Haoli Bai and Jiacheng Sun and Lifeng Shang and Farzan Farnia},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2610.36767},
  url = {https://doi.org/10.48550/arxiv.2610.36767},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {self-criticism, automated grading},
  abstract = {Large Language Models (LLMs) have made remarkable progress on solving competition-level mathematics, yet their ability to verify natural-language mathematical proofs remains relatively underexplored. This gap is especially pronounced for Olympiad-level proofs, which require meticulous assessment of each claim in a long reasoning chain. Current proof verification thus primarily relies on expert inspection, which is costly to scale. In this paper, we present a systematic study of LLM-based verification in this setting. Specifically, we introduce a human-curated dataset of USAMO 2025 candidate solutions with expert grading, and conduct a broad evaluation of existing LLM verifiers across frontier models. We also propose TROJAN, an iterative self-critique pipeline for generating high-fidelity adversarial proofs at scale. Our comprehensive evaluation covers 20 models spanning seven metrics, two prompt styles, three inference methods, and three prompt templates, showing that state-of-the-art models still leave considerable room for improvement. To narrow this gap, we propose MABGrader, a Multi-Armed Bandit framework that reframes grading as arm selection over the discrete score space. MABGrader outperforms the SOTA ProofGrader by 26.4% in Quadratic Weighted Kappa and reduces grading error by 14%. Code and dataset are available at https://github.com/aziksh-ospanov/TROJAN.},
}

@article{guo2026chemargus,
  title = {ChemArgus: Automated Scientific Diagnostics for Lab-Grade Multimodal Chemistry Reasoning: A Frontier Benchmark},
  author = {Hanyao Guo and Mo Cui and Zihan Tan and Leixin Sun and Yichun Wang and Yinan Shen and Guojun Zhu and Jia Jiang and Erhao Chen and Zui Chen and Wenzhe Gao and Zhihao Yu and 汪启军 and Yetian Zhu and Jiande Chen and Chuhang Pei and Yao Jiang and Yichen Fan and Pinhan Wang and Xiaorui Pan and Qianyi Zhu and Yang Liu† and Mang Ye and Guancheng Wan},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2610.20012},
  url = {https://doi.org/10.48550/arxiv.2610.20012},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {chemistry competition problems, GPT-5.6 Sol, language model evaluation},
  abstract = {Chemistry evaluation has moved past multiple-choice probes toward open-ended expert problems, yet the benchmarks that define the current frontier still score answer endpoints alone. Such scoring conflates memorized facts with stepwise derivation, treats visual and textual inputs as interchangeable, and confounds long-horizon planning with stepwise execution. These blind spots prevent any diagnosis of where the reasoning chain breaks in a model. We present ChemArgus, a competition-level chemistry benchmark drawn from chemistry competition material, textbooks, and research papers, whose scoring replaces the answer endpoint with three measurement properties. Fine-grained scoring grades every subquestion point by point with partial credit, so a score lands at the level of the step rather than the outcome. Multimodal capability is priced on every problem containing a real image, paired with a controlled text description, so visual understanding is measured against text on identical tasks. Diagnostic attribution reads paired metrics that share one scoring unit and differ only in context construction, so a gap between two scores isolates a single cause, namely integration, propagation, or local reasoning. GPT-5.6-Sol scores 23.2% on unassisted whole-problem solving against 28.8% and 30.4% under the two sequential metrics, a gap measuring the integration burden. Through rubric partial credit and these cause-isolating score gaps, ChemArgus shows not only whether a model answers chemistry correctly but where its reasoning chain fails, so that every score it reports doubles as a diagnosis, a readout of the chain rather than a verdict, aiming to guide language models step by step on their path toward chemistry expertise, one corrected step at a time, each step priced by the rubric, point by point.},
}

