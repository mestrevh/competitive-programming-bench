@article{chen2026folding,
  title = {Folding Context into Executable States: Structured Strategy Folding for Long-Horizon Reasoning Agent},
  author = {Zhengyu Chen and Luan Zhang and Zhaoyi Li and Jinluan Yang and Zheqi Lv and Teng Xiao and Wei Wang and Jingang Wang},
  journal = {Findings of the Association for Computational Linguistics: EMNLP (Findings of EMNLP)},
  year = {2026},
  pages = {28192--28209},
  doi = {10.18653/2026.findings-emnlp.1331},
  url = {https://doi.org/10.18653/2026.findings-emnlp.1331},
  publisher = {Association for Computational Linguistics},
  keywords = {LLM agents, long-horizon reasoning, memory mechanisms, error propagation, chain-of-thought, mathematical reasoning, program execution},
  abstract = {Current Large Language Model (LLM) agents struggle with long-horizon reasoning tasks, such as competition-level mathematics, where sustaining precision over hundreds of steps is critical. A primary bottleneck is the reliance on natural language context or summaries to track progress; these linguistic representations are inherently "lossy," introducing semantic drift and accumulating errors that derail the reasoning chain. To address this, we propose Structured Strategy Folding (SSF), a novel paradigm that shifts the agent’s memory mechanism from linguistic description to computational verification. Instead of compressing history into text, SSF "folds" the reasoning trajectory into a sequence of Executable Symbolic States (ESS). Each ESS serves as a verifiable anchor—comprising either executed code artifacts or formally judged symbolic lemmas—generated through a dual-pathway validation mechanism. By interacting with these rigorous state artifacts rather than raw textual history, the agent effectively eliminates ambiguity and prevents error propagation. Experiments on challenging mathematical benchmarks demonstrate that SSF significantly outperforms standard Chain-of-Thought and existing summarization baselines, achieving substantial accuracy improvements while maintaining robust performance over extended reasoning horizons.},
}

@article{cai2026generalized,
  title = {Generalized Proximal Policy Optimization: Unifying LLM RL Algorithms from the Perspective of Divergence},
  author = {Zhicheng Cai and Xinyuan Guo and Hanlin Wu and Weinan Dai and Yuyan Zhou and Wei-Ying Ma and Ya-Qin Zhang and Hao Zhou},
  journal = {arXiv (Cornell University)},
  year = {2026},
  doi = {10.48550/arxiv.2610.13015},
  url = {https://doi.org/10.48550/arxiv.2610.13015},
  publisher = {Cornell University},
  issn = {2331-8422},
  keywords = {proximal policy optimization, large language models, reinforcement learning, f-divergence, trust-region optimization, clipping, divergence estimation, DAPO, Group Relative Policy Optimization},
  abstract = {Reinforcement learning has become the foundational paradigm for enhancing the reasoning capabilities of LLMs. Yet the dominant approach, Proximal Policy Optimization (PPO), relies on a geometrically degenerate clipping proxy that cannot adapt its resistance to policy shifts, leading to premature clipping and degraded exploration. Subsequent variants alleviate these issues through fragmented and heuristic modifications. We propose Generalized Proximal Policy Optimization (GPPO), a principled and unified framework for understanding and designing LLM RL algorithms through the lens of divergence. We establish a generalized $f$-divergence trust-region theory with a monotonic performance improvement guarantee, and show that different $f$-divergences induce distinct geometries and policy update dynamics. We further introduce novel estimator topologies that provide more faithful divergence estimates than the conventional single-sample Monte Carlo estimation. Under this framework, PPO and recent variants such as DAPO, DPPO, and RIPO emerge as special cases, establishing a principled two-dimensional design space of (Divergence $\times$ Estimator). Extensive experiments on eight competition-level math and coding benchmarks show that both dimensions are critical. The best-performing GPPO instantiation surpasses standard GRPO by up to 50% and 14% on math and coding, delivering SOTA performance.},
}

