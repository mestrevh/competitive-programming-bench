@article{okekale2026the,
  title = {The Reasoning Paradox in Scientific Sandboxes: Why Extended Reasoning Fails in Autonomous Bioinformatics and How to Fix It},
  author = {Redeemer Salami Okekale and Derek Amuna and Rachel Ama Adadziwa Akorful and Rathod Anjali and Collins M. Morang’a and Peter K. Quashie and Emmanuel Akomanin Asiamah and Rosina Carr and Ishmael Adase and Samuel Mawuli Kumordzi},
  journal = {bioRxiv (Cold Spring Harbor Laboratory)},
  year = {2026},
  doi = {10.64898/2026.10.30.763189},
  url = {https://doi.org/10.64898/2026.10.30.763189},
  publisher = {Cold Spring Harbor Laboratory},
  keywords = {large language models, multi-turn reasoning, empirical grounding, computational biology, single-cell RNA sequencing, differential gene expression, DeepSeek-R1, Qwen2.5-Coder},
  abstract = {Frontier large language models (LLMs) trained with extended reasoning, such as DeepSeek-R1 and OpenAI o1 , have established state-of-the-art benchmarks in formal logic, competitive programming, and mathematics. In interactive, empirical scientific sandboxes, however, their efficacy remains counter-intuitive. In the Bioinformatics Benchmark ( BixBench ), extended reasoning models paradoxically degraded in multi-turn environments, leading benchmark authors to exclude them from primary agentic evaluations. In this paper, we conduct the first systematic forensic audit of the internal cognitive monologue ( … ) of open-weight reasoning models ( DeepSeek-R1-Distill-Qwen-14B ) and matched instruction-tuned controls ( Qwen2.5-Coder-14B ) deployed inside containerized computational biology sandboxes on Nvidia H100 GPUs. Our forensic analysis uncovers two distinct systemic failure modes: (1) The PubMed Prior Trap , in which reasoning models engage in epistemic rationalization within their cognitive stream, falsely convincing themselves that empirical datasets are missing and substituting empirical computation with speculative literature recall (e.g., estimating adjusted p -values based on “typical experimental outcomes”); and (2) Tag Language Nesting Collisions , in which models conflate agent-level XML action tags with Python syntax, producing terminal interpreter syntax errors. To resolve this paradox, we introduce Dual Track Decoupled Reasoning ( DTDR ), an agent scaffolding architecture that evicts internal cognitive monologues from multi-turn history, injects strict empirical grounding guardrails, and dynamically intercepts runtime tool invocations. On a stratified diagnostic benchmark spanning single-cell RNA-seq, bulk differential expression (DESeq2), and genomic variant prioritization ( n = 22 per arm), DTDR rescues the 14B reasoning model from 0.0% to 9.09% accuracy (2/22) , doubling the performance of the matched non-reasoning coder control ( 4.55%, 1/22 ) while slashing code execution errors by 81% (13.6% vs. 72.7%) and reducing average steps to solution by 66% (1.77 vs. 5.18 steps). All replication pipelines, prompts, and trajectory manifests are openly released.},
}

@article{hale2026toward,
  title = {Toward Human-Level Grading of Programming Assignments (10% Deviation): Using LLMs for Automated Performance Evaluation},
  author = {Alexander Simon Häle},
  journal = {Digital Library of the University of Innsbruck (University of Innsbruck)},
  year = {2026},
  url = {https://resolver.obvsg.at/urn:nbn:at:at-ubi:1-195979},
  publisher = {Innsbruck Medical University},
  keywords = {automated grading, programming exercises, large language models, grading accuracy, GPT-5},
  abstract = {Large Language Models (LLMs) offer new opportunities to support educators in evaluating programming assignments, but their practical usefulness depends on whether they can reproduce structured, criteria-based grading with acceptable deviation from human assessors. This thesis presents the design and implementation of a lightweight, modular grading assistant for Java programming exercises that processes anonymised student submissions together with a lecturer-defined grading scheme and produces point-based grades and brief justifications. The work follows Design Science Research and uses the Goal–Question–Metric (GQM) approach to define evaluation goals and metrics. Grading accuracy is assessed using the Mean Absolute Difference (MAD) between LLM-assigned points and a dual-human reference (supervisor and author average), normalised by the exercise maximum to obtain MAD%. Human-level grading is operationalised as an average deviation of at most 10% (i.e., within one grade step on average). The evaluation was conducted with GPT-5 on a dataset covering three supervisors, three tests per supervisor, and three exercises per test (27 exercises in total), comprising 409 graded student submissions. Across all exercises, the LLM achieved an average MAD% of 6.80%, and 22 out of 27 exercises met the predefined 10% threshold. The total cost of the grading runs was $38.69 (33.23 EUR), corresponding to approximately 0.081 EUR per graded student submission. In addition to grading, the tool also implements auxiliary features such as automated JUnit test generation and Docker-based execution; however, these components are demonstrated but not quantitatively evaluated in this study.},
}

