count;\n}\n\nlet ways = 0;\n\nif (diameter % 2 === 0) {\n  const center = path[diameter / 2];\n  const targetDepth = diameter / 2;\n  const branchCounts = [];\n\n  for (const neighbor of graph[center]) {\n    branchCounts.push(countAtDepth(neighbor, center, targetDepth - 1));\n  }\n\n  let seen = 0;\n  for (const count of branchCounts) {\n    ways += seen * count;\n    seen += count;\n  }\n} else {\n  const leftCenter = path[Math.floor(diameter / 2)];\n  const rightCenter = path[Math.floor(diameter / 2) + 1];\n  const depth = Math.floor(diameter / 2);\n\n  ways =\n    countAtDepth(leftCenter, rightCenter, depth) *\n    countAtDepth(rightCenter, leftCenter, depth);\n}\n\nconsole.log(`${diameter + 1}\\n${ways}`);\n```",
