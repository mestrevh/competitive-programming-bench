        "raw_response": "```javascript\n'use strict';\n\nconst fs = require('fs');\nconst input = fs.readFileSync(0, 'utf8').trim().split(/\\s+/).map(Number);\n\nconst n = input[0];\nconst graph = Array.from({ length: n + 1 }, () => []);\nlet index = 1;\n\nfor (let i = 0; i < n - 1; i++) {\n  const a = input[index++];\n  const b = input[index++];\n  graph[a].push(b);\n  graph[b].push(a);\n}\n\nconst parent = new Int32Array(n + 1);\nconst order = [1];\nparent[1] = -1;\n\nfor (let i = 0; i < order.length; i++) {\n  const node = order[i];\n  for (const next of graph[node]) {\n    if (next !== parent[node]) {\n      parent[next] = node;\n      order.push(next);\n    }\n  }\n}\n\nconst subtreeSize = new Int32Array(n + 1);\nsubtreeSize.fill(1);\n\nlet answer = n;\n\nfor (let i = order.length - 1; i > 0; i--) {\n  const node = order[i];\n  const size = subtreeSize[node];\n  answer = Math.min(answer, Math.abs(n - 2 * size));\n  subtreeSize[parent[node]] += size;\n}\n\nconsole.log(answer.toString());\n```",
